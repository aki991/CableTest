<UserControl x:Class="CableTest.App.Views.VozilaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <!-- Pregled vozila iz kataloga. Izmena kataloga još nije na redu — ovaj ekran pokazuje šta u
         bazi stoji, da operater ne mora da je otvara alatom za SQL. -->

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= ZAGLAVLJE ================= -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Vozila" Style="{StaticResource NaslovStraneStyle}" />
            <TextBlock Text="Vozila za koja postoje kablovski setovi u katalogu."
                       Style="{StaticResource OpisStraneStyle}" />
        </StackPanel>

        <!-- ================= PLOČICE ================= -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding VehicleRows}" Margin="0,0,0,18">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource IvicaBrush}"
                            BorderThickness="1" CornerRadius="12"
                            Padding="20,18" Margin="0,0,16,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaVozilo}"
                                      Width="21" Height="21" Stroke="{DynamicResource AkcenatJakBrush}"
                                      VerticalAlignment="Center" Margin="0,0,11,0" />
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TekstJakBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{Binding CableCount}" FontSize="30" FontWeight="Bold"
                                       Foreground="{DynamicResource AkcenatJakBrush}" Margin="0,12,0,0" />
                            <TextBlock Text="kablova u katalogu" FontSize="13.5"
                                       Foreground="{DynamicResource Tekst2Brush}" Margin="0,3,0,0" />

                            <TextBlock Margin="0,12,0,0" FontSize="13.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Tekst2Brush}">
                                <Run Text="Oznake:" />
                                <Run Text="{Binding Range, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ================= TABELA ================= -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource IvicaBrush}" BorderThickness="1"
                CornerRadius="12" Padding="20,18,20,20">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Pregled" Style="{StaticResource SectionTitleStyle}" />

                <Border BorderBrush="{DynamicResource IvicaBrush}" BorderThickness="1" CornerRadius="10">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel3Brush}"
                                BorderBrush="{DynamicResource IvicaBrush}" BorderThickness="0,0,0,1"
                                CornerRadius="10,10,0,0" Padding="14,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Vozilo" Style="{StaticResource ZaglavljeTabeleStyle}" />
                                <TextBlock Grid.Column="1" Text="Kablova" Style="{StaticResource ZaglavljeTabeleStyle}"
                                           TextAlignment="Right" Margin="0,0,14,0" />
                                <TextBlock Grid.Column="2" Text="Netova" Style="{StaticResource ZaglavljeTabeleStyle}"
                                           TextAlignment="Right" Margin="0,0,14,0" />
                                <TextBlock Grid.Column="3" Text="Ispitnih tačaka" Style="{StaticResource ZaglavljeTabeleStyle}"
                                           TextAlignment="Right" Margin="0,0,14,0" />
                            </Grid>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding VehicleRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource RedIvicaBrush}" BorderThickness="0,0,0,1" Padding="14,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="160" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           Style="{StaticResource CelijaStyle}" />
                                                <TextBlock Grid.Column="1" Text="{Binding CableCount}"
                                                           Style="{StaticResource CelijaStyle}"
                                                           TextAlignment="Right" Margin="0,0,14,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding NetCount}"
                                                           Style="{StaticResource CelijaStyle}"
                                                           TextAlignment="Right" Margin="0,0,14,0" />
                                                <TextBlock Grid.Column="3" Text="{Binding PointCount}"
                                                           Style="{StaticResource CelijaStyle}"
                                                           TextAlignment="Right" Margin="0,0,14,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
