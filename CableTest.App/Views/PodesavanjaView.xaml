<UserControl x:Class="CableTest.App.Views.PodesavanjaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cfg="clr-namespace:CableTest.Core.Configuration;assembly=CableTest.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <!-- Podešavanja u upotrebi. Ekran uglavnom samo prikazuje — izmena se radi u settings.json,
         a ovde se vidi šta je aplikacija zaista pročitala. Izuzetak su tema i razvojni prekidač:
         njih operater menja odavde i važe odmah. -->

    <UserControl.Resources>
        <Style x:Key="OdeljakStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IvicaBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,20" MaxWidth="900" HorizontalAlignment="Left">

            <TextBlock Text="Podešavanja" Style="{StaticResource NaslovStraneStyle}" />
            <TextBlock Style="{StaticResource OpisStraneStyle}" Margin="0,0,0,18">
                <Run Text="Vrednosti sa kojima aplikacija trenutno radi. Tema i razvojni prekidač se menjaju odavde i važe odmah; ostalo se menja u fajlu" />
                <Run Text="{Binding SettingsFileText, Mode=OneWay}" FontFamily="Consolas"
                     Foreground="{DynamicResource TekstBrush}" />
                <Run Text="i važi od sledećeg pokretanja." />
            </TextBlock>

            <!-- ================= IZGLED ================= -->
            <!--
                Jedino podešavanje na ovom ekranu koje se i menja odavde, a ne u settings.json:
                temu operater bira prema svetlu nad svojim stolom, a to se menja u toku smene.
            -->
            <Border Style="{StaticResource OdeljakStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <Border Background="{DynamicResource Panel3Brush}"
                            BorderBrush="{DynamicResource IvicaBrush}" BorderThickness="0,0,0,1"
                            CornerRadius="12,12,0,0" Padding="20,13">
                        <TextBlock Text="Izgled" Style="{StaticResource OdeljakNaslovStyle}" />
                    </Border>

                    <StackPanel Margin="20,16,20,18">
                        <TextBlock Text="Tema" Style="{StaticResource SectionTitleStyle}" />
                        <ComboBox ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding Theme}"
                                  Width="260" HorizontalAlignment="Left">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!--
                                            Uzorak podloge uz ime teme: brže se bira okom nego
                                            čitanjem. Boje su namerno upisane, a ne uzete iz
                                            teme — uzorak pokazuje kako izgleda TA tema, pa ne
                                            sme da se menja zajedno sa onom koja trenutno važi.
                                        -->
                                        <Border Width="34" Height="18" CornerRadius="5"
                                                BorderThickness="1" Margin="0,0,12,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#141414" />
                                                    <Setter Property="BorderBrush" Value="#3A3A3A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Static cfg:AppTheme.Light}">
                                                            <Setter Property="Background" Value="#FFFFFF" />
                                                            <Setter Property="BorderBrush" Value="#C8C5BE" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Rectangle Width="16" Height="4" RadiusX="2" RadiusY="2"
                                                       Fill="#E0A155" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Tamna — za rad iznad ispitnog stola" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Static cfg:AppTheme.Light}">
                                                            <Setter Property="Text" Value="Svetla — za sto uz prozor" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Style="{StaticResource OpisStraneStyle}" Margin="0,7,0,0"
                                   Text="Važi odmah i pamti se. Tamna tema je podrazumevana jer ekran stoji ceo radni dan iznad ispitnog stola; svetla je za mesta pod jakim plafonskim svetlom, gde tamna podloga postaje ogledalo." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= PUTANJE ================= -->
            <Border Style="{StaticResource OdeljakStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <Border Background="{DynamicResource Panel3Brush}"
                            BorderBrush="{DynamicResource IvicaBrush}" BorderThickness="0,0,0,1"
                            CornerRadius="12,12,0,0" Padding="20,13">
                        <TextBlock Text="Putanje" Style="{StaticResource OdeljakNaslovStyle}" />
                    </Border>

                    <Grid Margin="20,16,20,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Spec folder (.c61):"
                                   Style="{StaticResource PodatakNazivStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SpecFolder}"
                                   Style="{StaticResource PodatakVrednostStyle}" FontFamily="Consolas" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Rezultati (CSV):"
                                   Style="{StaticResource PodatakNazivStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ResultPath}"
                                   Style="{StaticResource PodatakVrednostStyle}" FontFamily="Consolas" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Šablon MASTER.c61:"
                                   Style="{StaticResource PodatakNazivStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TemplatePathText}"
                                   Style="{StaticResource PodatakVrednostStyle}" FontFamily="Consolas" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Prati se:"
                                   Style="{StaticResource PodatakNazivStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Testing.WatchedFileText}"
                                   Style="{StaticResource PodatakVrednostStyle}" FontFamily="Consolas" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= RAD ================= -->
            <Border Style="{StaticResource OdeljakStyle}">
                <StackPanel>
                    <Border Background="{DynamicResource Panel3Brush}"
                            BorderBrush="{DynamicResource IvicaBrush}" BorderThickness="0,0,0,1"
                            CornerRadius="12,12,0,0" Padding="20,13">
                        <TextBlock Text="Rad" Style="{StaticResource OdeljakNaslovStyle}" />
                    </Border>

                    <Grid Margin="20,16,20,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Operater:"
                                   Style="{StaticResource PodatakNazivStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OperatorName}"
                                   Style="{StaticResource PodatakVrednostStyle}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Zvučni signal uz rezultat:"
                                   Style="{StaticResource PodatakNazivStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SoundText}"
                                   Style="{StaticResource PodatakVrednostStyle}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Demo režim:"
                                   Style="{StaticResource PodatakNazivStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DemoText}"
                                   Style="{StaticResource PodatakVrednostStyle}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Nadgledanje:"
                                   Style="{StaticResource PodatakNazivStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Testing.StatusText}"
                                   Style="{StaticResource PodatakVrednostStyle}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Obrađeno rezultata:"
                                   Style="{StaticResource PodatakNazivStyle}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Testing.ProcessedText}"
                                   Style="{StaticResource PodatakVrednostStyle}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Izvor rezultata:"
                                   Style="{StaticResource PodatakNazivStyle}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ResultSourceText}"
                                   Style="{StaticResource PodatakVrednostStyle}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Čekanje na rezultat:"
                                   Style="{StaticResource PodatakNazivStyle}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ResultTimeoutText}"
                                   Style="{StaticResource PodatakVrednostStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= RAZVOJ ================= -->
            <Border Style="{StaticResource OdeljakStyle}" Margin="0,18,0,0">
                <StackPanel>
                    <Border Background="{DynamicResource Panel3Brush}"
                            BorderBrush="{DynamicResource IvicaBrush}" BorderThickness="0,0,0,1"
                            CornerRadius="12,12,0,0" Padding="20,13">
                        <TextBlock Text="Razvoj" Style="{StaticResource OdeljakNaslovStyle}" />
                    </Border>

                    <StackPanel Margin="20,16,20,18">
                        <CheckBox Content="Prikaži CableConnector alat (razvoj)"
                                  IsChecked="{Binding ShowCableConnector}" />
                        <TextBlock Style="{StaticResource OpisStraneStyle}" Margin="29,7,0,0"
                                   Text="Dodaje na dno bočnog menija stranu za ispitivanje Microtest CableConnector-a preko Windows UI Automation. Namenjena je razvoju, ne radu u pogonu; prekidač važi odmah i pamti se." />
                        <!--
                            Izbor izvora rezultata se vidi samo uz uključen razvojni prekidač.
                            Simulacija ne sme da se nađe pred operaterom slučajno.
                        -->
                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding ShowResultSourceChoice, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Izvor rezultata" Style="{StaticResource SectionTitleStyle}" />
                            <ComboBox ItemsSource="{Binding ResultSources}" SelectedItem="{Binding ResultSource}"
                                      Width="260" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource OpisStraneStyle}" Margin="0,7,0,0"
                                       Text="„File“ čita CSV koji piše CableConnector — to je jedini izvor za rad u pogonu. „Simulation“ čita pripremljene fajlove i služi razvoju; važi od sledećeg pokretanja." />
                        </StackPanel>

                        <TextBlock Text="{Binding SettingsError}" TextWrapping="Wrap" Margin="29,9,0,0"
                                   FontSize="13.5" Foreground="{DynamicResource ErrorBrush}"
                                   Visibility="{Binding HasSettingsError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
