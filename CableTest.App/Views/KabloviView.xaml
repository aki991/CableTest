<UserControl x:Class="CableTest.App.Views.KabloviView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <!-- Ceo katalog kablova na jednom mestu, sa mapom portova svakog kabla. -->

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Kablovi" Style="{StaticResource NaslovStraneStyle}" />
            <TextBlock Text="Kablovski setovi iz kataloga, sa net listom i portovima testera koje koriste."
                       Style="{StaticResource OpisStraneStyle}" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource IvicaBrush}" BorderThickness="1"
                CornerRadius="12" Padding="20,18,20,20">
            <DockPanel>

                <!-- ================= PRETRAGA ================= -->
                <Grid DockPanel.Dock="Top" Width="460" HorizontalAlignment="Left" Margin="0,0,0,14">
                    <TextBox Text="{Binding CableFilter, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Pretraga po oznaci, nazivu ili vozilu…"
                             Padding="37,9,11,9" />
                    <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaLupa}"
                          Width="17" Height="17" Stroke="{StaticResource Tekst3Brush}"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Margin="12,0,0,0" IsHitTestVisible="False" />
                </Grid>

                <!-- ================= TABELA ================= -->
                <Border BorderBrush="{StaticResource IvicaBrush}" BorderThickness="1" CornerRadius="10">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource Panel3Brush}"
                                BorderBrush="{StaticResource IvicaBrush}" BorderThickness="0,0,0,1"
                                CornerRadius="10,10,0,0" Padding="14,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Oznaka" Style="{StaticResource ZaglavljeTabeleStyle}" />
                                <TextBlock Grid.Column="1" Text="Vozilo" Style="{StaticResource ZaglavljeTabeleStyle}" />
                                <TextBlock Grid.Column="2" Text="Naziv" Style="{StaticResource ZaglavljeTabeleStyle}" />
                                <TextBlock Grid.Column="3" Text="Netova" Style="{StaticResource ZaglavljeTabeleStyle}"
                                           TextAlignment="Right" Margin="0,0,14,0" />
                                <TextBlock Grid.Column="4" Text="Tačaka" Style="{StaticResource ZaglavljeTabeleStyle}"
                                           TextAlignment="Right" Margin="0,0,14,0" />
                                <TextBlock Grid.Column="5" Text="Portovi" Style="{StaticResource ZaglavljeTabeleStyle}" />
                                <TextBlock Grid.Column="6" Text="Test program" Style="{StaticResource ZaglavljeTabeleStyle}" />
                            </Grid>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CableRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1" Padding="14,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="1.3*" />
                                                    <ColumnDefinition Width="150" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Code}"
                                                           Style="{StaticResource CelijaStyle}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding VehicleName}"
                                                           Style="{StaticResource CelijaStyle}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Description}"
                                                           Style="{StaticResource CelijaStyle}" />
                                                <TextBlock Grid.Column="3" Text="{Binding NetCount}"
                                                           Style="{StaticResource CelijaStyle}"
                                                           TextAlignment="Right" Margin="0,0,14,0" />
                                                <TextBlock Grid.Column="4" Text="{Binding PointCount}"
                                                           Style="{StaticResource CelijaStyle}"
                                                           TextAlignment="Right" Margin="0,0,14,0" />
                                                <TextBlock Grid.Column="5" Text="{Binding Ports}"
                                                           Style="{StaticResource CelijaJednoprostornaStyle}"
                                                           ToolTip="{Binding Ports}" />
                                                <TextBlock Grid.Column="6" Text="{Binding SpecFile}"
                                                           Style="{StaticResource CelijaJednoprostornaStyle}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
