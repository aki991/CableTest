<UserControl x:Class="CableTest.App.Views.TestingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CableTest.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400">

    <!-- Glavni ekran — „Ispitivanje". Tri koraka sleva nadesno, redom kojim ih operater i radi:
         izbor kabla, priprema test programa, ishod. -->

    <UserControl.Resources>

        <!-- Kartica jednog koraka. -->
        <Style x:Key="KarticaStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource IvicaBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20,18,20,20" />
        </Style>

        <!-- Uokviren odeljak unutar kartice. -->
        <Style x:Key="OdeljakStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource IvicaBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.9*" MinWidth="280" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1*" MinWidth="320" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1.35*" MinWidth="380" />
        </Grid.ColumnDefinitions>

        <!-- ================================================================================
             1. IZBOR KABLA
             ================================================================================ -->
        <Border Grid.Column="0" Style="{StaticResource KarticaStyle}">
            <DockPanel>

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="1. Izbor kabla" Style="{StaticResource NaslovKarticeStyle}" />
                    <Rectangle Height="1" Fill="{StaticResource IvicaBrush}" Margin="0,12,0,18" />

                    <TextBlock Text="Vozilo" Style="{StaticResource LabelStyle}" />
                    <ComboBox ItemsSource="{Binding Vehicles}"
                              SelectedItem="{Binding SelectedVehicle}"
                              DisplayMemberPath="Name"
                              Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="PoljePretrage"
                                     Text="{Binding CableFilter, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Pretraga po oznaci ili nazivu…"
                                     Padding="37,9,11,9" />
                            <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaLupa}"
                                  Width="17" Height="17" Stroke="{StaticResource Tekst3Brush}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Margin="12,0,0,0" IsHitTestVisible="False" />
                        </Grid>

                        <!-- Skener barkoda se ponaša kao tastatura: upisuje očitanu oznaku u
                             polje koje je u fokusu. -->
                        <Button Grid.Column="1" Width="46" Margin="8,0,0,0"
                                Style="{StaticResource DugmeStyle}" Padding="0"
                                Click="OnBarkod"
                                ToolTip="Skeniraj barkod — skener upisuje oznaku u polje za pretragu">
                            <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaBarkod}"
                                  Width="22" Height="22"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </Grid>
                </StackPanel>

                <Border Style="{StaticResource OdeljakStyle}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource Panel3Brush}"
                                BorderBrush="{StaticResource IvicaBrush}" BorderThickness="0,0,0,1"
                                CornerRadius="10,10,0,0" Padding="14,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Oznaka" Style="{StaticResource ZaglavljeTabeleStyle}" />
                                <TextBlock Grid.Column="1" Text="Naziv" Style="{StaticResource ZaglavljeTabeleStyle}" />
                            </Grid>
                        </Border>

                        <ListBox ItemsSource="{Binding Cables}"
                                 SelectedItem="{Binding SelectedCable}"
                                 Style="{StaticResource SpisakStyle}"
                                 ItemContainerStyle="{StaticResource RedKablaStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="20" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Code}"
                                                   FontSize="14.5" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Description}"
                                                   FontSize="14.5" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Path Grid.Column="2" Style="{StaticResource IkonaStyle}"
                                              Data="{StaticResource IkonaStrelica}"
                                              Width="15" Height="15" Opacity="0.5"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                              VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ================================================================================
             2. TEST PROGRAM
             ================================================================================ -->
        <Border Grid.Column="2" Style="{StaticResource KarticaStyle}">
            <DockPanel>

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="2. Test program" Style="{StaticResource NaslovKarticeStyle}" />
                    <Rectangle Height="1" Fill="{StaticResource IvicaBrush}" Margin="0,12,0,18" />
                </StackPanel>

                <!-- Dugme koje operater zaista pritiska stoji uz dno kartice. -->
                <Button DockPanel.Dock="Bottom"
                        Style="{StaticResource GlavnoDugmeStyle}"
                        Command="{Binding PrepareTestCommand}"
                        Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IkonaPokreni}" Fill="{StaticResource BelaBrush}"
                              Stretch="Uniform" Width="17" Height="17" Margin="0,0,11,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Pripremi test program" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- ====================== Podaci o kablu ====================== -->
                        <Border Style="{StaticResource OdeljakStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <Border Background="{StaticResource Panel3Brush}"
                                        BorderBrush="{StaticResource IvicaBrush}" BorderThickness="0,0,0,1"
                                        CornerRadius="10,10,0,0" Padding="16,12">
                                    <TextBlock Text="Podaci o kablu" Style="{StaticResource OdeljakNaslovStyle}" />
                                </Border>

                                <StackPanel Margin="16,14,16,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Oznaka kabla:"
                                                   Style="{StaticResource PodatakNazivStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCableCode}"
                                                   Style="{StaticResource PodatakVrednostStyle}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Naziv:"
                                                   Style="{StaticResource PodatakNazivStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCableName}"
                                                   Style="{StaticResource PodatakVrednostStyle}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Broj netova:"
                                                   Style="{StaticResource PodatakNazivStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedNetCount}"
                                                   Style="{StaticResource PodatakVrednostStyle}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Broj ispitnih tačaka:"
                                                   Style="{StaticResource PodatakNazivStyle}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedPointCount}"
                                                   Style="{StaticResource PodatakVrednostStyle}" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Broj portova:"
                                                   Style="{StaticResource PodatakNazivStyle}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedPortCount}"
                                                   Style="{StaticResource PodatakVrednostStyle}" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Fajl test programa:"
                                                   Style="{StaticResource PodatakNazivStyle}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedSpecFileText}"
                                                   Style="{StaticResource PodatakVrednostStyle}"
                                                   FontFamily="Consolas" />
                                    </Grid>

                                    <!-- Poruka o pripremljenom test programu -->
                                    <Border Background="{StaticResource AkcenatPrigusenBrush}"
                                            BorderBrush="{StaticResource IvicaJakaBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,10" Margin="0,4,0,10"
                                            Visibility="{Binding HasPrepareMessage, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource IkonaStyle}"
                                                  Data="{StaticResource IkonaKrugPotvrda}"
                                                  Width="19" Height="19" Stroke="{StaticResource BelaBrush}"
                                                  VerticalAlignment="Top" Margin="0,1,10,0" />
                                            <TextBlock Text="{Binding PrepareMessage}" TextWrapping="Wrap"
                                                       FontSize="13.5" Foreground="{StaticResource TekstBrush}"
                                                       MaxWidth="330" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource ErrorBackBrush}"
                                            BorderBrush="{StaticResource FailBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,10" Margin="0,4,0,10"
                                            Visibility="{Binding HasPrepareError, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding PrepareError}" TextWrapping="Wrap"
                                                   FontSize="13.5" Foreground="{StaticResource ErrorBrush}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ====================== Mapa pinova ====================== -->
                        <Border Style="{StaticResource OdeljakStyle}">
                            <StackPanel>
                                <Border Background="{StaticResource Panel3Brush}"
                                        BorderBrush="{StaticResource IvicaBrush}" BorderThickness="0,0,0,1"
                                        CornerRadius="10,10,0,0" Padding="16,12">
                                    <TextBlock Text="Konektor / mapa pinova" Style="{StaticResource OdeljakNaslovStyle}" />
                                </Border>

                                <StackPanel Margin="16,14,16,16">
                                    <ItemsControl ItemsSource="{Binding Ports}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,8,8" CornerRadius="8" BorderThickness="1"
                                                        Padding="0,8,0,7" ToolTip="{Binding Description}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource Panel3Brush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource IvicaJakaBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Used}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource PinKoriscenBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource PinKoriscenIvicaBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Letter}" FontSize="15" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource Tekst3Brush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Used}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource PinKoriscenTekstBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <Ellipse Width="7" Height="7" Margin="0,5,0,0"
                                                                 HorizontalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{StaticResource PinBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Used}" Value="True">
                                                                            <Setter Property="Fill" Value="{StaticResource PinKoriscenTekstBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Ellipse Width="9" Height="9" Fill="{StaticResource BelaBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock Text="Koristi ovaj kabl" FontSize="13"
                                                   Foreground="{StaticResource Tekst2Brush}" Margin="0,0,18,0" />
                                        <Ellipse Width="9" Height="9" Fill="{StaticResource PinBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock Text="Ne koristi se" FontSize="13"
                                                   Foreground="{StaticResource Tekst2Brush}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================================================================================
             3. REZULTAT
             ================================================================================ -->
        <Border Grid.Column="4" Style="{StaticResource KarticaStyle}">
            <DockPanel>

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="3. Rezultat" Style="{StaticResource NaslovKarticeStyle}" />
                    <Rectangle Height="1" Fill="{StaticResource IvicaBrush}" Margin="0,12,0,18" />

                    <!-- ====================== Veliki prikaz ishoda ====================== -->
                    <Border CornerRadius="12" BorderThickness="1" Padding="24,28" MinHeight="150">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource WaitingBackBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource IvicaJakaBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource WaitingBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:OutcomeState.Pass}">
                                        <Setter Property="Background" Value="{StaticResource PassBackBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PassBorderBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource PassBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:OutcomeState.Fail}">
                                        <Setter Property="Background" Value="{StaticResource FailBackBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource FailBorderBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource FailBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <!-- Znak ishoda: pun krug sa kvačicom, odnosno obris sa uzvičnikom. -->
                            <Grid Width="88" Height="88" Margin="0,0,22,0" VerticalAlignment="Center">
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="Transparent" />
                                            <Setter Property="Stroke" Value="{StaticResource WaitingBrush}" />
                                            <Setter Property="StrokeThickness" Value="3" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:OutcomeState.Pass}">
                                                    <Setter Property="Fill" Value="{StaticResource PassBrush}" />
                                                    <Setter Property="StrokeThickness" Value="0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:OutcomeState.Fail}">
                                                    <Setter Property="Fill" Value="{StaticResource FailBrush}" />
                                                    <Setter Property="StrokeThickness" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stretch="Uniform" Width="46" Height="46"
                                      StrokeThickness="2.6" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="{StaticResource IkonaSat}" />
                                            <Setter Property="Stroke" Value="{StaticResource WaitingBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:OutcomeState.Pass}">
                                                    <Setter Property="Data" Value="{StaticResource IkonaPotvrda}" />
                                                    <Setter Property="Stroke" Value="{StaticResource PassBackBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:OutcomeState.Fail}">
                                                    <Setter Property="Data" Value="{StaticResource IkonaUzvicnik}" />
                                                    <Setter Property="Stroke" Value="{StaticResource FailBackBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>

                            <StackPanel VerticalAlignment="Center">
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="76">
                                    <TextBlock Text="{Binding OutcomeText}" FontSize="66" FontWeight="Bold" />
                                </Viewbox>
                                <TextBlock Text="{Binding OutcomeSubText}" FontSize="16" FontWeight="SemiBold"
                                           Opacity="0.85" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="330" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ====================== Podaci o rezultatu ====================== -->
                    <StackPanel Margin="4,16,4,0"
                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                            <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaSat}"
                                  Width="18" Height="18" Stroke="{StaticResource Tekst3Brush}"
                                  VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="Vreme testa:" Style="{StaticResource StatusLabelStyle}" FontSize="15" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ResultTimeText}" Style="{StaticResource StatusValueStyle}" FontSize="15" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                            <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaKabl}"
                                  Width="18" Height="18" Stroke="{StaticResource Tekst3Brush}"
                                  VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="Kabl:" Style="{StaticResource StatusLabelStyle}" FontSize="15" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ResultCableText}" Style="{StaticResource StatusValueStyle}" FontSize="15" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                            <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaOperater}"
                                  Width="18" Height="18" Stroke="{StaticResource Tekst3Brush}"
                                  VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="Operater:" Style="{StaticResource StatusLabelStyle}" FontSize="15" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ResultOperatorText}" Style="{StaticResource StatusValueStyle}" FontSize="15" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Obaveštenje o zatečenim rezultatima -->
                    <Border Background="{StaticResource WarningBackBrush}"
                            BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,6,0,0"
                            Visibility="{Binding HasBackfillNotice, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding BackfillNoticeText}" TextWrapping="Wrap"
                                   FontSize="13" Foreground="{StaticResource WarningBrush}" />
                    </Border>

                    <!-- ====================== Pronađene greške ====================== -->
                    <Border Style="{StaticResource OdeljakStyle}" Margin="0,14,0,0"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Border Background="{StaticResource Panel3Brush}"
                                    BorderBrush="{StaticResource IvicaBrush}" BorderThickness="0,0,0,1"
                                    CornerRadius="10,10,0,0" Padding="16,12">
                                <TextBlock Text="Pronađene greške" Style="{StaticResource OdeljakNaslovStyle}" />
                            </Border>

                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="16,12,16,12">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding ResultDefects}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="14.5" TextWrapping="Wrap"
                                                           Margin="0,2" Foreground="{StaticResource FailBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Nema grešaka." FontSize="14.5"
                                               Foreground="{StaticResource PassBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ResultDefects.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Net lista izabranog kabla" Style="{StaticResource SectionTitleStyle}"
                               Margin="2,18,0,10" />
                </StackPanel>

                <!-- ====================== Merna karta ====================== -->
                <Button DockPanel.Dock="Bottom"
                        Style="{StaticResource BigButtonStyle}"
                        Command="{Binding MeasurementCardCommand}"
                        Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaProgram}"
                              Width="19" Height="19" Margin="0,0,11,0" VerticalAlignment="Center"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="Merna karta" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- ====================== Tabela netova ====================== -->
                <Border BorderBrush="{StaticResource IvicaBrush}" BorderThickness="1" CornerRadius="10">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource Panel3Brush}"
                                BorderBrush="{StaticResource IvicaBrush}" BorderThickness="0,0,0,1"
                                CornerRadius="10,10,0,0" Padding="14,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Net" Style="{StaticResource ZaglavljeTabeleStyle}" />
                                <TextBlock Grid.Column="1" Text="Od" Style="{StaticResource ZaglavljeTabeleStyle}" />
                                <TextBlock Grid.Column="2" Text="Do" Style="{StaticResource ZaglavljeTabeleStyle}" />
                                <TextBlock Grid.Column="3" Text="Tačaka" Style="{StaticResource ZaglavljeTabeleStyle}"
                                           TextAlignment="Right" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="4" Text="Stanje" Style="{StaticResource ZaglavljeTabeleStyle}" />
                            </Grid>
                        </Border>

                        <Grid>
                            <TextBlock Text="Izaberi kabl da bi se prikazala net lista."
                                       Foreground="{StaticResource Tekst3Brush}" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NetRows.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding NetRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1"
                                                    Padding="14,11" ToolTip="{Binding Description}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="78" />
                                                        <ColumnDefinition Width="78" />
                                                        <ColumnDefinition Width="66" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Ordinal}"
                                                               Style="{StaticResource CelijaStyle}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding From}"
                                                               Style="{StaticResource CelijaJednoprostornaStyle}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding To}"
                                                               Style="{StaticResource CelijaJednoprostornaStyle}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding PointCount}"
                                                               Style="{StaticResource CelijaStyle}"
                                                               TextAlignment="Right" Margin="0,0,10,0" />

                                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                        <Path Width="15" Height="15" Stretch="Uniform"
                                                              StrokeThickness="1.8" StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                              VerticalAlignment="Center" Margin="0,0,7,0">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Data" Value="{StaticResource IkonaSat}" />
                                                                    <Setter Property="Stroke" Value="{StaticResource Tekst3Brush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPassed}" Value="True">
                                                                            <Setter Property="Data" Value="{StaticResource IkonaKrugPotvrda}" />
                                                                            <Setter Property="Stroke" Value="{StaticResource PassBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                            <Setter Property="Data" Value="{StaticResource IkonaUzvicnik}" />
                                                                            <Setter Property="Stroke" Value="{StaticResource FailBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>

                                                        <TextBlock Text="{Binding Status}" FontSize="14"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource Tekst3Brush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPassed}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource PassBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource FailBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
