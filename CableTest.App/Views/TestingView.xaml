<UserControl x:Class="CableTest.App.Views.TestingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CableTest.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400">

    <!-- Glavni ekran — „Ispitivanje". Tri koraka sleva nadesno, redom kojim ih operater i radi:
         izbor kabla, priprema test programa, ishod. -->

    <UserControl.Resources>

        <!-- Kartica jednog koraka. -->
        <Style x:Key="KarticaStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IvicaBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20,18,20,20" />
        </Style>

        <!-- Uokviren odeljak unutar kartice. -->
        <Style x:Key="OdeljakStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IvicaBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.9*" MinWidth="280" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1*" MinWidth="320" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1.35*" MinWidth="380" />
        </Grid.ColumnDefinitions>

        <!-- ================================================================================
             1. IZBOR KABLA
             ================================================================================ -->
        <Border Grid.Column="0" Style="{StaticResource KarticaStyle}">
            <DockPanel>

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="1. Izbor kabla" Style="{StaticResource NaslovKarticeStyle}" />
                    <Rectangle Style="{StaticResource NaslovLinijaStyle}" />

                    <TextBlock Text="Vozilo" Style="{StaticResource LabelStyle}" />
                    <ComboBox ItemsSource="{Binding Vehicles}"
                              SelectedItem="{Binding SelectedVehicle}"
                              DisplayMemberPath="Name"
                              Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="PoljePretrage"
                                     Text="{Binding CableFilter, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Pretraga po oznaci ili nazivu…"
                                     Padding="37,9,11,9" />
                            <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaLupa}"
                                  Width="17" Height="17" Stroke="{DynamicResource Tekst3Brush}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Margin="12,0,0,0" IsHitTestVisible="False" />
                        </Grid>

                        <!-- Skener barkoda se ponaša kao tastatura: upisuje očitanu oznaku u
                             polje koje je u fokusu. -->
                        <Button Grid.Column="1" Width="46" Margin="8,0,0,0"
                                Style="{StaticResource DugmeStyle}" Padding="0"
                                Click="OnBarkod"
                                ToolTip="Skeniraj barkod — skener upisuje oznaku u polje za pretragu">
                            <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaBarkod}"
                                  Width="22" Height="22"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </Grid>
                </StackPanel>

                <Border Style="{StaticResource OdeljakStyle}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel3Brush}"
                                BorderBrush="{DynamicResource IvicaBrush}" BorderThickness="0,0,0,1"
                                CornerRadius="10,10,0,0" Padding="14,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Oznaka" Style="{StaticResource ZaglavljeTabeleStyle}" />
                                <TextBlock Grid.Column="1" Text="Naziv" Style="{StaticResource ZaglavljeTabeleStyle}" />
                            </Grid>
                        </Border>

                        <ListBox ItemsSource="{Binding Cables}"
                                 SelectedItem="{Binding SelectedCable}"
                                 Style="{StaticResource SpisakStyle}"
                                 ItemContainerStyle="{StaticResource RedKablaStyle}">
                            <!--
                                Kablovi se prikazuju po grupama: prvo zaglavlje („Grupa 40"), pa
                                kablovi iz nje kad se otvori.

                                Grupisanje radi sam pogled nad spiskom, pa ovo ostaje JEDAN
                                ListBox — izbor kabla, kretanje tastaturom i pretraga rade kao i
                                pre. Ključ grupe je zaglavlje iz CableGroups, otuda
                                „Name.IsExpanded": „Name" je taj objekat, a ne oznaka grupe.
                            -->
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <StackPanel>
                                                            <ToggleButton Style="{StaticResource GrupaKablovaStyle}"
                                                                          DataContext="{Binding Name}"
                                                                          IsChecked="{Binding IsExpanded, Mode=TwoWay}" />
                                                            <ItemsPresenter
                                                                Visibility="{Binding Name.IsExpanded, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ListBox.GroupStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="20" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Code}"
                                                   FontSize="14.5" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Description}"
                                                   FontSize="14.5" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Path Grid.Column="2" Style="{StaticResource IkonaStyle}"
                                              Data="{StaticResource IkonaStrelica}"
                                              Width="15" Height="15" Opacity="0.5"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                              VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ================================================================================
             2. TEST PROGRAM
             ================================================================================ -->
        <Border Grid.Column="2" Style="{StaticResource KarticaStyle}">
            <DockPanel>

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="2. Test program" Style="{StaticResource NaslovKarticeStyle}" />
                    <Rectangle Style="{StaticResource NaslovLinijaStyle}" />
                </StackPanel>

                <!-- Dugmad koja operater zaista pritiska stoje uz dno kartice. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Button Style="{StaticResource GlavnoDugmeStyle}"
                            Command="{Binding PrepareTestCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IkonaProgram}" Stroke="{DynamicResource CrnaBrush}"
                                  Style="{StaticResource IkonaStyle}"
                                  Width="17" Height="17" Margin="0,0,11,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Pripremi test program" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!--
                        „Pokreni test" postoji samo kad veza to ume. Kod rada preko fajlova START
                        pritiska operater na mašini — tada umesto dugmeta stoji uputstvo.
                    -->
                    <Button Style="{StaticResource BigButtonStyle}" Margin="0,10,0,0"
                            Command="{Binding StartTestCommand}"
                            Visibility="{Binding CanShowStartButton, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IkonaPokreni}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" Width="15" Height="15" Margin="0,0,11,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Pokreni test" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Background="{DynamicResource WarningBackBrush}"
                            BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,10,0,0"
                            Visibility="{Binding ShowStartInstruction, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding StartInstruction}" TextWrapping="Wrap"
                                   FontSize="13.5" Foreground="{DynamicResource WarningBrush}" />
                    </Border>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- ====================== Podaci o kablu ====================== -->
                        <Border Style="{StaticResource OdeljakStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <Border Background="{DynamicResource Panel3Brush}"
                                        BorderBrush="{DynamicResource IvicaBrush}" BorderThickness="0,0,0,1"
                                        CornerRadius="10,10,0,0" Padding="16,12">
                                    <TextBlock Text="Podaci o kablu" Style="{StaticResource OdeljakNaslovStyle}" />
                                </Border>

                                <StackPanel Margin="16,14,16,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Oznaka kabla:"
                                                   Style="{StaticResource PodatakNazivStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCableCode}"
                                                   Style="{StaticResource PodatakVrednostStyle}" />

                                        <!--
                                            Net je jedan KRAJ žice, a ispitna tačka je veza
                                            između dva kraja („A01-B01"). Zato netova ima dvaput
                                            više nego žica, a ispitnih tačaka tačno onoliko
                                            koliko kabl ima žica.
                                        -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Broj netova:"
                                                   Style="{StaticResource PodatakNazivStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEndCount}"
                                                   Style="{StaticResource PodatakVrednostStyle}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Broj ispitnih tačaka:"
                                                   Style="{StaticResource PodatakNazivStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedConnectionCount}"
                                                   Style="{StaticResource PodatakVrednostStyle}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Broj portova:"
                                                   Style="{StaticResource PodatakNazivStyle}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedPortCount}"
                                                   Style="{StaticResource PodatakVrednostStyle}" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Fajl test programa:"
                                                   Style="{StaticResource PodatakNazivStyle}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedSpecFileText}"
                                                   Style="{StaticResource PodatakVrednostStyle}"
                                                   FontFamily="Consolas" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Dužina:"
                                                   Style="{StaticResource PodatakNazivStyle}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedLengthText}"
                                                   Style="{StaticResource PodatakVrednostStyle}"
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <!--
                                        Dok adapter nije napravljen, raspored tačaka je izabran „na papiru".
                                        Operater to mora da vidi: rezultat po pogrešnom rasporedu ne znači ništa.
                                    -->
                                    <Border Background="{DynamicResource WarningBackBrush}"
                                            BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,10" Margin="0,8,0,4"
                                            Visibility="{Binding HasProvisionalPoints, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding ProvisionalNoticeText}" TextWrapping="Wrap"
                                                   FontSize="13" Foreground="{DynamicResource WarningBrush}" />
                                    </Border>

                                    <!-- Napomene sa crteža, doslovno -->
                                    <TextBlock Text="{Binding SelectedNotesText}" TextWrapping="Wrap"
                                               FontSize="12.5" Margin="0,6,0,4"
                                               Foreground="{DynamicResource Tekst3Brush}"
                                               Visibility="{Binding HasSelectedNotes, Converter={StaticResource BoolToVisibility}}" />

                                    <!-- Poruka o pripremljenom test programu -->
                                    <Border Background="{DynamicResource AkcenatPrigusenBrush}"
                                            BorderBrush="{DynamicResource AkcenatIvicaBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,10" Margin="0,4,0,10"
                                            Visibility="{Binding HasPrepareMessage, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource IkonaStyle}"
                                                  Data="{StaticResource IkonaKrugPotvrda}"
                                                  Width="19" Height="19" Stroke="{DynamicResource AkcenatJakBrush}"
                                                  VerticalAlignment="Top" Margin="0,1,10,0" />
                                            <TextBlock Text="{Binding PrepareMessage}" TextWrapping="Wrap"
                                                       FontSize="13.5" Foreground="{DynamicResource TekstBrush}"
                                                       MaxWidth="330" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource ErrorBackBrush}"
                                            BorderBrush="{DynamicResource FailBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,10" Margin="0,4,0,10"
                                            Visibility="{Binding HasPrepareError, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding PrepareError}" TextWrapping="Wrap"
                                                   FontSize="13.5" Foreground="{DynamicResource ErrorBrush}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ====================== Provodnici i izvedeni netovi ====================== -->
                        <!--
                            Tabela provodnika je prepis crteža i ne zavisi od testera; net lista
                            ispod nje se iz nje IZVODI, kroz priključnu tabelu terminala. Zato
                            stoje jedna uz drugu: operater vidi i kabl i ono što ide u tester.
                        -->
                        <Border Style="{StaticResource OdeljakStyle}" Margin="0,0,0,16"
                                Visibility="{Binding HasWires, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Border Background="{DynamicResource Panel3Brush}"
                                        BorderBrush="{DynamicResource IvicaBrush}" BorderThickness="0,0,0,1"
                                        CornerRadius="10,10,0,0" Padding="16,12">
                                    <TextBlock Text="Provodnici sa crteža" Style="{StaticResource OdeljakNaslovStyle}" />
                                </Border>

                                <StackPanel Margin="16,12,16,14">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="95" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Br." Style="{StaticResource ZaglavljeTabeleStyle}" />
                                        <TextBlock Grid.Column="1" Text="Boja" Style="{StaticResource ZaglavljeTabeleStyle}" />
                                        <TextBlock Grid.Column="2" Text="Presek" Style="{StaticResource ZaglavljeTabeleStyle}" />
                                        <TextBlock Grid.Column="3" Text="Od → do" Style="{StaticResource ZaglavljeTabeleStyle}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Wires}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3" ToolTip="{Binding Notes}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="95" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding WireNo}"
                                                               Style="{StaticResource CelijaJednoprostornaStyle}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Color}"
                                                               Style="{StaticResource CelijaStyle}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding CrossSectionText}"
                                                               Style="{StaticResource CelijaJednoprostornaStyle}" />
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding FromTerminal}"
                                                                   Style="{StaticResource CelijaJednoprostornaStyle}" />
                                                        <TextBlock Text=" → " Style="{StaticResource CelijaStyle}" />
                                                        <TextBlock Text="{Binding ToTerminal}"
                                                                   Style="{StaticResource CelijaJednoprostornaStyle}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--
                                        Ovde stoje VEZE, ne netovi: po jedan red za svaku vezu
                                        između dve tačke testera, tačno onako kako ide u .c61.
                                        U net listi desno je jedan red po KRAJU žice, pa ih je
                                        tamo dvaput više — to su dve različite stvari i zato se
                                        i zovu različito.
                                    -->
                                    <TextBlock Text="Izvedene veze (ono što ide u tester)"
                                               Style="{StaticResource SectionTitleStyle}" Margin="0,14,0,6" />

                                    <ItemsControl ItemsSource="{Binding Nets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13"
                                                           Margin="0,2" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TekstBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ====================== Mapa pinova ====================== -->
                        <Border Style="{StaticResource OdeljakStyle}">
                            <StackPanel>
                                <Border Background="{DynamicResource Panel3Brush}"
                                        BorderBrush="{DynamicResource IvicaBrush}" BorderThickness="0,0,0,1"
                                        CornerRadius="10,10,0,0" Padding="16,12">
                                    <TextBlock Text="Konektor / mapa pinova" Style="{StaticResource OdeljakNaslovStyle}" />
                                </Border>

                                <StackPanel Margin="16,14,16,16">
                                    <!--
                                        Stoje samo portovi koje kabl zaista koristi. Tester ih ima
                                        šesnaest (A..P), a kabl retko dodiruje više od dva — prikaz
                                        svih šesnaest je značio da operater svaki put traži ona dva
                                        među četrnaest praznih.
                                    -->
                                    <ItemsControl ItemsSource="{Binding Ports}"
                                                  Visibility="{Binding HasPorts, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,8,8" CornerRadius="8" BorderThickness="1"
                                                        MinWidth="58" Padding="10,8,10,7"
                                                        Background="{DynamicResource PinKoriscenBrush}"
                                                        BorderBrush="{DynamicResource PinKoriscenIvicaBrush}"
                                                        ToolTip="{Binding Description}">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Letter}" FontSize="16" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource PinKoriscenTekstBrush}" />
                                                        <TextBlock FontSize="11.5" HorizontalAlignment="Center"
                                                                   Margin="0,2,0,0" Opacity="0.75"
                                                                   Foreground="{DynamicResource PinKoriscenTekstBrush}">
                                                            <Run Text="{Binding PointCount, Mode=OneWay}" />
                                                            <Run Text="tač." />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Izabrani kabl ne koristi nijedan port testera."
                                               FontSize="13.5" Foreground="{DynamicResource Tekst3Brush}"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPorts}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================================================================================
             3. REZULTAT
             ================================================================================ -->
        <Border Grid.Column="4" Style="{StaticResource KarticaStyle}">
            <DockPanel>

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="3. Rezultat" Style="{StaticResource NaslovKarticeStyle}" />
                    <Rectangle Style="{StaticResource NaslovLinijaStyle}" />

                    <!-- ====================== Veliki prikaz ishoda ====================== -->
                    <Border CornerRadius="12" BorderThickness="1" Padding="24,28" MinHeight="150">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource WaitingBackBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource IvicaJakaBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource WaitingBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:OutcomeState.Pass}">
                                        <Setter Property="Background" Value="{DynamicResource PassBackBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PassBorderBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource PassBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:OutcomeState.Fail}">
                                        <Setter Property="Background" Value="{DynamicResource FailBackBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource FailBorderBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource FailBrush}" />
                                    </DataTrigger>

                                    <!-- Test u toku: ni prošao ni pao — mora da se razlikuje od oba. -->
                                    <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:OutcomeState.Running}">
                                        <Setter Property="Background" Value="{DynamicResource AkcenatPrigusenBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AkcenatIvicaBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource AkcenatJakBrush}" />
                                    </DataTrigger>

                                    <!-- Istek vremena i greška: žuto, jer kabl NIJE ispitan. -->
                                    <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:OutcomeState.TimedOut}">
                                        <Setter Property="Background" Value="{DynamicResource WarningBackBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:OutcomeState.Error}">
                                        <Setter Property="Background" Value="{DynamicResource ErrorBackBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource FailBorderBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <!--
                                Znak ishoda: pun krug sa kvačicom, odnosno obris sa uzvičnikom.

                                Dok se rezultat čeka znaka nema. Prazan krug sa satom nije govorio
                                ništa što već ne piše u tekstu pored njega, a zauzimao je mesto
                                koje pripada samom ishodu.
                            -->
                            <Grid Width="88" Height="88" Margin="0,0,22,0" VerticalAlignment="Center">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:OutcomeState.Waiting}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="Transparent" />
                                            <Setter Property="Stroke" Value="{DynamicResource WaitingBrush}" />
                                            <Setter Property="StrokeThickness" Value="3" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:OutcomeState.Pass}">
                                                    <Setter Property="Fill" Value="{DynamicResource PassBrush}" />
                                                    <Setter Property="StrokeThickness" Value="0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:OutcomeState.Fail}">
                                                    <Setter Property="Fill" Value="{DynamicResource FailBrush}" />
                                                    <Setter Property="StrokeThickness" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stretch="Uniform" Width="46" Height="46"
                                      StrokeThickness="2.6" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="{StaticResource IkonaSat}" />
                                            <Setter Property="Stroke" Value="{DynamicResource WaitingBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:OutcomeState.Pass}">
                                                    <Setter Property="Data" Value="{StaticResource IkonaPotvrda}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource PassBackBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:OutcomeState.Fail}">
                                                    <Setter Property="Data" Value="{StaticResource IkonaUzvicnik}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource FailBackBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:OutcomeState.Running}">
                                                    <Setter Property="Data" Value="{StaticResource IkonaOsvezi}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource AkcenatJakBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:OutcomeState.TimedOut}">
                                                    <Setter Property="Data" Value="{StaticResource IkonaSat}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:OutcomeState.Error}">
                                                    <Setter Property="Data" Value="{StaticResource IkonaUzvicnik}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>

                            <StackPanel VerticalAlignment="Center">
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="76">
                                    <TextBlock Text="{Binding OutcomeText}" FontSize="66" FontWeight="Bold" />
                                </Viewbox>
                                <TextBlock Text="{Binding OutcomeSubText}" FontSize="16" FontWeight="SemiBold"
                                           Opacity="0.85" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="330" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ====================== Stanje veze sa testerom ====================== -->
                    <Grid Margin="4,12,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding TesterStateText}" TextWrapping="Wrap"
                                   Style="{StaticResource StatusLabelStyle}" FontSize="14"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="1" Content="Prekini čekanje"
                                Style="{StaticResource SmallButtonStyle}" Margin="10,0,0,0"
                                Command="{Binding CancelWaitCommand}"
                                Visibility="{Binding IsWaitingForResult, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <!-- ====================== Mreže koje nisu prošle ====================== -->
                    <Border Background="{DynamicResource FailBackBrush}"
                            BorderBrush="{DynamicResource FailBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14,12" Margin="0,14,0,0"
                            Visibility="{Binding HasFailedNets, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding FailedNetsSummary}" FontSize="14.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FailBrush}" TextWrapping="Wrap"
                                       Margin="0,0,0,8" />

                            <ItemsControl ItemsSource="{Binding FailedNetRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="13.5"
                                                       Foreground="{DynamicResource FailBrush}"
                                                       Margin="0,0,10,0" VerticalAlignment="Top">
                                                <Run Text="mreža" />
                                                <Run Text="{Binding Ordinal, Mode=OneWay}" />
                                            </TextBlock>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontFamily="Consolas"
                                                           FontSize="13.5" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TekstBrush}">
                                                    <Run Text="{Binding Point, Mode=OneWay}" />
                                                    <Run Text="u vezi" />
                                                    <Run Text="{Binding Connection, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Defect}" FontSize="13"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource FailBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ====================== Podaci o rezultatu ====================== -->
                    <StackPanel Margin="4,16,4,0"
                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                            <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaSat}"
                                  Width="18" Height="18" Stroke="{DynamicResource Tekst3Brush}"
                                  VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="Vreme testa:" Style="{StaticResource StatusLabelStyle}" FontSize="15" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ResultTimeText}" Style="{StaticResource StatusValueStyle}" FontSize="15" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                            <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaKabl}"
                                  Width="18" Height="18" Stroke="{DynamicResource Tekst3Brush}"
                                  VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="Kabl:" Style="{StaticResource StatusLabelStyle}" FontSize="15" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ResultCableText}" Style="{StaticResource StatusValueStyle}" FontSize="15" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                            <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaOperater}"
                                  Width="18" Height="18" Stroke="{DynamicResource Tekst3Brush}"
                                  VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="Operater:" Style="{StaticResource StatusLabelStyle}" FontSize="15" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ResultOperatorText}" Style="{StaticResource StatusValueStyle}" FontSize="15" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Obaveštenje o zatečenim rezultatima -->
                    <Border Background="{DynamicResource WarningBackBrush}"
                            BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,6,0,0"
                            Visibility="{Binding HasBackfillNotice, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding BackfillNoticeText}" TextWrapping="Wrap"
                                   FontSize="13" Foreground="{DynamicResource WarningBrush}" />
                    </Border>

                    <!-- ====================== Pronađene greške ====================== -->
                    <Border Style="{StaticResource OdeljakStyle}" Margin="0,14,0,0"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Border Background="{DynamicResource Panel3Brush}"
                                    BorderBrush="{DynamicResource IvicaBrush}" BorderThickness="0,0,0,1"
                                    CornerRadius="10,10,0,0" Padding="16,12">
                                <TextBlock Text="Pronađene greške" Style="{StaticResource OdeljakNaslovStyle}" />
                            </Border>

                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="16,12,16,12">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding ResultDefects}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="14.5" TextWrapping="Wrap"
                                                           Margin="0,2" Foreground="{DynamicResource FailBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Nema grešaka." FontSize="14.5"
                                               Foreground="{DynamicResource PassBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ResultDefects.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Net lista izabranog kabla" Style="{StaticResource SectionTitleStyle}"
                               Margin="2,18,0,10" />
                </StackPanel>

                <!-- ====================== Merna karta ====================== -->
                <Button DockPanel.Dock="Bottom"
                        Style="{StaticResource BigButtonStyle}"
                        Command="{Binding MeasurementCardCommand}"
                        Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaProgram}"
                              Width="19" Height="19" Margin="0,0,11,0" VerticalAlignment="Center"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="Merna karta" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- ====================== Tabela netova ====================== -->
                <Border BorderBrush="{DynamicResource IvicaBrush}" BorderThickness="1" CornerRadius="10">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel3Brush}"
                                BorderBrush="{DynamicResource IvicaBrush}" BorderThickness="0,0,0,1"
                                CornerRadius="10,10,0,0" Padding="14,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="98" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Net" Style="{StaticResource ZaglavljeTabeleStyle}" />
                                <TextBlock Grid.Column="1" Text="Tačka" Style="{StaticResource ZaglavljeTabeleStyle}"
                                           ToolTip="Konektor testera i broj tačke u njemu" />
                                <TextBlock Grid.Column="2" Text="Pinovi" Style="{StaticResource ZaglavljeTabeleStyle}"
                                           ToolTip="Par pinova tog konektora koji čini tačku" />
                                <TextBlock Grid.Column="3" Text="Žica" Style="{StaticResource ZaglavljeTabeleStyle}" />
                                <TextBlock Grid.Column="4" Text="Veza" Style="{StaticResource ZaglavljeTabeleStyle}" />
                                <TextBlock Grid.Column="5" Text="Stanje" Style="{StaticResource ZaglavljeTabeleStyle}" />
                            </Grid>
                        </Border>

                        <Grid>
                            <TextBlock Text="Izaberi kabl da bi se prikazala net lista."
                                       Foreground="{DynamicResource Tekst3Brush}" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NetRows.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding NetRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource RedIvicaBrush}" BorderThickness="0,0,0,1"
                                                    Padding="14,11" ToolTip="{Binding Description}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="66" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="58" />
                                                        <ColumnDefinition Width="98" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Ordinal}"
                                                               Style="{StaticResource CelijaStyle}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Point}"
                                                               Style="{StaticResource CelijaJednoprostornaStyle}" />
                                                    <!-- Pinovi slede iz tačke, pa su prigušeni: podatak za
                                                         ukrcavanje na adapteru, ne zaseban izbor. -->
                                                    <TextBlock Grid.Column="2" Text="{Binding Pins}"
                                                               Style="{StaticResource CelijaJednoprostornaStyle}"
                                                               Foreground="{DynamicResource Tekst2Brush}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Wire}"
                                                               Style="{StaticResource CelijaStyle}" />
                                                    <!-- Veza je ista za oba kraja iste žice — prigušena je,
                                                         da se u koloni vidi da idu u paru. -->
                                                    <TextBlock Grid.Column="4" Text="{Binding Connection}"
                                                               Style="{StaticResource CelijaJednoprostornaStyle}"
                                                               Foreground="{DynamicResource Tekst2Brush}" />

                                                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                                                        <Path Width="15" Height="15" Stretch="Uniform"
                                                              StrokeThickness="1.8" StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                              VerticalAlignment="Center" Margin="0,0,7,0">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Data" Value="{StaticResource IkonaSat}" />
                                                                    <Setter Property="Stroke" Value="{DynamicResource Tekst3Brush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPassed}" Value="True">
                                                                            <Setter Property="Data" Value="{StaticResource IkonaKrugPotvrda}" />
                                                                            <Setter Property="Stroke" Value="{DynamicResource PassBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                            <Setter Property="Data" Value="{StaticResource IkonaUzvicnik}" />
                                                                            <Setter Property="Stroke" Value="{DynamicResource FailBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>

                                                        <TextBlock Text="{Binding Status}" FontSize="14"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Tekst3Brush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPassed}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource PassBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource FailBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
