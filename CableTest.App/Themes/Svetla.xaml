<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ================================================================================
        SVETLA TEMA
        ================================================================================

        Ista aplikacija za sto koji stoji uz prozor ili pod jakim plafonskim svetlom, gde
        tamna podloga postaje ogledalo. Pravila su ista kao u tamnoj temi, samo obrnuta:

        • podloga je topla bela (#F2F1EE), a ne čisto bela — ceo dan pred očima, čisto
          belo zamara i pravi „sjaj" ispod radioničke rasvete;
        • naglasak je ISTA narandžasta radionice, ali u dve jačine: površina ostaje
          svetla (dugme mora da izgleda isto u obe teme), dok narandžasta KAO TEKST mora
          da bude znatno tamnija — svetla narandžasta na beloj podlozi se ne čita;
        • ishodi (PROŠAO/PAO) su tamniji nego u tamnoj temi, iz istog razloga.

        Svaki ključ iz „Tamna.xaml" mora da postoji i ovde, inače bi pri promeni teme
        ostao nerazrešen.
        ================================================================================
    -->

    <!-- ============================ PODLOGE ============================ -->
    <SolidColorBrush x:Key="PozadinaBrush" Color="#F2F1EE" />
    <SolidColorBrush x:Key="MeniBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#FAF9F7" />
    <SolidColorBrush x:Key="Panel3Brush" Color="#F0EEEA" />

    <!-- ============================ IVICE ============================ -->
    <SolidColorBrush x:Key="IvicaBrush" Color="#E2E0DB" />
    <SolidColorBrush x:Key="IvicaJakaBrush" Color="#C8C5BE" />
    <SolidColorBrush x:Key="RedIvicaBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="PreletBrush" Color="#0C000000" />
    <SolidColorBrush x:Key="IstaknutaStavkaBrush" Color="#14000000" />
    <SolidColorBrush x:Key="KlizacBrush" Color="#C4C1BA" />

    <!-- ============================ TEKST ============================ -->
    <SolidColorBrush x:Key="TekstBrush" Color="#1E1E1C" />
    <SolidColorBrush x:Key="Tekst2Brush" Color="#5C5A55" />
    <SolidColorBrush x:Key="Tekst3Brush" Color="#8B8880" />
    <SolidColorBrush x:Key="TekstJakBrush" Color="#101010" />
    <SolidColorBrush x:Key="CrnaBrush" Color="#111111" />

    <!-- ============================ ZAGLAVLJE ============================
         U svetloj temi zaglavlje se vraća na belo — podlogu za koju je znak firme i
         crtan, pa se prikazuje neizmenjen, onakav kakav jeste. -->
    <LinearGradientBrush x:Key="ZaglavljeBrush" StartPoint="0,0" EndPoint="1,0.4">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#FAFAF9" Offset="0.6" />
        <GradientStop Color="#F1F0ED" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ZaglavljeTekstBrush" Color="#111111" />
    <SolidColorBrush x:Key="ZaglavljeTekst2Brush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="ZaglavljeIvicaBrush" Color="#D8D5D0" />
    <SolidColorBrush x:Key="ZaglavljePoljeBrush" Color="#F4F3F0" />
    <SolidColorBrush x:Key="ZaglavljePreletBrush" Color="#14000000" />

    <DrawingBrush x:Key="ZaglavljePrugeBrush" TileMode="Tile"
                  Viewport="0,0,26,26" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="Black" Geometry="M0,0 L3,0 L3,26 L0,26 Z" />
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <LinearGradientBrush x:Key="ZaglavljeNitBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#D9862F" Offset="0" />
        <GradientStop Color="#E3B583" Offset="0.45" />
        <GradientStop Color="#00D9862F" Offset="1" />
    </LinearGradientBrush>

    <!-- Belo zaglavlje je podloga za koju je znak i crtan: ovde ide sama slika, sa svim
         svojim sivim tonovima, a silueta se sklanja. -->
    <SolidColorBrush x:Key="ZnakBrush" Color="#111111" />
    <Visibility x:Key="ZnakSlikaVidljivost">Visible</Visibility>
    <Visibility x:Key="ZnakSiluetaVidljivost">Collapsed</Visibility>

    <!-- ============================ NAGLASAK ============================ -->
    <SolidColorBrush x:Key="AkcenatBrush" Color="#D9862F" />
    <!-- Narandžasta kao TEKST: na beloj podlozi mora znatno tamnija od one na crnoj. -->
    <SolidColorBrush x:Key="AkcenatJakBrush" Color="#9C5A11" />
    <SolidColorBrush x:Key="AkcenatPrigusenBrush" Color="#FCF3E6" />
    <SolidColorBrush x:Key="AkcenatIvicaBrush" Color="#EBD2AD" />
    <SolidColorBrush x:Key="SivaZnakaBrush" Color="#9A9A9A" />

    <!-- Glavno dugme namerno zadržava isti preliv kao u tamnoj temi: operater ga pamti
         po boji, a ne po temi u kojoj radi. -->
    <LinearGradientBrush x:Key="AkcenatPovrsinaBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E8AC63" Offset="0" />
        <GradientStop Color="#D2914A" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AkcenatPovrsinaJakaBrush" Color="#EDB878" />

    <LinearGradientBrush x:Key="NaslovLinijaBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#D9862F" Offset="0" />
        <GradientStop Color="#E9D2B4" Offset="0.3" />
        <GradientStop Color="#E2E0DB" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="IzabranRedBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FBEEDA" Offset="0" />
        <GradientStop Color="#FEFAF3" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================ ISHODI ============================ -->
    <SolidColorBrush x:Key="PassBrush" Color="#0E7A3C" />
    <SolidColorBrush x:Key="PassBackBrush" Color="#E3F5E9" />
    <SolidColorBrush x:Key="PassBorderBrush" Color="#8CCCA5" />
    <SolidColorBrush x:Key="FailBrush" Color="#C01B31" />
    <SolidColorBrush x:Key="FailBackBrush" Color="#FCE8EB" />
    <SolidColorBrush x:Key="FailBorderBrush" Color="#E6A0AA" />
    <SolidColorBrush x:Key="WaitingBrush" Color="#6B6963" />
    <SolidColorBrush x:Key="WaitingBackBrush" Color="#F0EEEA" />

    <!-- ============================ PORUKE ============================ -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#BF1F33" />
    <SolidColorBrush x:Key="ErrorBackBrush" Color="#FCEAEC" />
    <SolidColorBrush x:Key="WarningBrush" Color="#8A6410" />
    <SolidColorBrush x:Key="WarningBackBrush" Color="#FBF3DF" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#E5D3A4" />
    <SolidColorBrush x:Key="DemoBrush" Color="#EFEDE9" />
    <SolidColorBrush x:Key="DemoBorderBrush" Color="#C8C5BE" />
    <SolidColorBrush x:Key="DemoTextBrush" Color="#2A2A28" />

    <!-- ============================ MAPA PINOVA ============================
         Prikazuju se samo portovi koje kabl koristi, pa boje za neiskorišćene nema. -->
    <LinearGradientBrush x:Key="PinKoriscenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E8AC63" Offset="0" />
        <GradientStop Color="#CC8B45" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PinKoriscenIvicaBrush" Color="#C4832F" />
    <SolidColorBrush x:Key="PinKoriscenTekstBrush" Color="#150F07" />

</ResourceDictionary>
