<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ================================================================================
        TAMNA („RADIONIČKA") TEMA
        ================================================================================

        Ekran stoji ceo radni dan iznad ispitnog stola, često pored jakog svetla, i
        operater ga gleda sa dva-tri koraka. Otuda tamna podloga, krupan tekst i jedno
        jedino mesto koje sme da bude svetlo i šareno: veliki prikaz ishoda. Sve ostalo
        je namerno prigušeno, da PROŠAO/PAO nikad nema takmaca u vidnom polju.

        Uz svaku boju ide i tekst — boja sama nije dovoljna (daltonizam).

        Ovde su SAMO boje. Oblici, razmaci i ponašanje kontrola stoje u App.xaml i isti
        su za obe teme; svaki ključ odavde mora da postoji i u „Svetla.xaml", inače bi
        pri promeni teme ostao nerazrešen.
        ================================================================================
    -->

    <!-- ============================ PODLOGE ============================ -->
    <SolidColorBrush x:Key="PozadinaBrush" Color="#0E0E0E" />
    <SolidColorBrush x:Key="MeniBrush" Color="#0A0A0A" />
    <SolidColorBrush x:Key="PanelBrush" Color="#161616" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="Panel3Brush" Color="#242424" />

    <!-- ============================ IVICE ============================ -->
    <SolidColorBrush x:Key="IvicaBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="IvicaJakaBrush" Color="#3A3A3A" />
    <!-- Linija između redova u spiskovima i tabelama. -->
    <SolidColorBrush x:Key="RedIvicaBrush" Color="#26FFFFFF" />
    <!-- Prelet mišem i istaknuta stavka u padajućoj listi. -->
    <SolidColorBrush x:Key="PreletBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="IstaknutaStavkaBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="KlizacBrush" Color="#3D3D3D" />

    <!-- ============================ TEKST ============================ -->
    <SolidColorBrush x:Key="TekstBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="Tekst2Brush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="Tekst3Brush" Color="#6E6E6E" />
    <!-- Najjači tekst na ekranu: naslovi kartica i strana. -->
    <SolidColorBrush x:Key="TekstJakBrush" Color="#FFFFFF" />
    <!-- Tekst i ikone NA narandžastoj podlozi; tamni su u obe teme. -->
    <SolidColorBrush x:Key="CrnaBrush" Color="#111111" />

    <!-- ============================ ZAGLAVLJE ============================
         Zaglavlje je crno: znak firme se na njemu prikazuje u beloj silueti, a jedina
         boja koja sme tu da stoji je prigušena narandžasta radionice. -->
    <LinearGradientBrush x:Key="ZaglavljeBrush" StartPoint="0,0" EndPoint="1,0.4">
        <GradientStop Color="#000000" Offset="0" />
        <GradientStop Color="#0C0C0C" Offset="0.55" />
        <GradientStop Color="#050505" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ZaglavljeTekstBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ZaglavljeTekst2Brush" Color="#8E8E8E" />
    <SolidColorBrush x:Key="ZaglavljeIvicaBrush" Color="#242424" />
    <SolidColorBrush x:Key="ZaglavljePoljeBrush" Color="#141414" />
    <SolidColorBrush x:Key="ZaglavljePreletBrush" Color="#1FFFFFFF" />

    <!-- Kose pruge — isti motiv kao na znaku firme; na crnom zaglavlju bele. -->
    <DrawingBrush x:Key="ZaglavljePrugeBrush" TileMode="Tile"
                  Viewport="0,0,26,26" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="White" Geometry="M0,0 L3,0 L3,26 L0,26 Z" />
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Tanka narandžasta nit uz donju ivicu zaglavlja — kao pod naponom. -->
    <LinearGradientBrush x:Key="ZaglavljeNitBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E0A155" Offset="0" />
        <GradientStop Color="#8A5F30" Offset="0.45" />
        <GradientStop Color="#00E0A155" Offset="1" />
    </LinearGradientBrush>

    <!--
        Znak firme je crno-sivi crtež na providnoj podlozi i na crnom zaglavlju se ne bi
        video. Zato se u ovoj temi ne prikazuje kao slika, nego kao bela površina kojoj
        sam znak služi kao maska providnosti: ostaje ista silueta, samo bela.
    -->
    <SolidColorBrush x:Key="ZnakBrush" Color="#FFFFFF" />
    <Visibility x:Key="ZnakSlikaVidljivost">Collapsed</Visibility>
    <Visibility x:Key="ZnakSiluetaVidljivost">Visible</Visibility>

    <!-- ============================ NAGLASAK ============================
         Prigušena narandžasta — boja tople signalne lampe u radionici, a ne upozorenja.
         Namerno je neznija od čiste narandžaste: stoji ceo radni dan na ekranu i ne sme
         da otme pažnju velikom prikazu ishoda.
         Nosi je: izabrana stavka menija, izabran red, polje u fokusu i jedno glavno
         dugme po ekranu. -->
    <SolidColorBrush x:Key="AkcenatBrush" Color="#E0A155" />
    <!-- Narandžasta kao TEKST i ikona; na tamnom sme da bude svetlija. -->
    <SolidColorBrush x:Key="AkcenatJakBrush" Color="#EDB878" />
    <SolidColorBrush x:Key="AkcenatPrigusenBrush" Color="#241A10" />
    <SolidColorBrush x:Key="AkcenatIvicaBrush" Color="#4A3720" />
    <SolidColorBrush x:Key="SivaZnakaBrush" Color="#8E8E8E" />

    <!-- Narandžasta kao POVRŠINA: glavno dugme i kvadratić sa munjom u zaglavlju. -->
    <LinearGradientBrush x:Key="AkcenatPovrsinaBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E8AC63" Offset="0" />
        <GradientStop Color="#D2914A" Offset="1" />
    </LinearGradientBrush>
    <!-- Ista površina pri preletu — svetlija, ali i dalje površina, a ne boja teksta. -->
    <SolidColorBrush x:Key="AkcenatPovrsinaJakaBrush" Color="#EDB878" />

    <!-- Linija ispod naslova kartice: narandžasta uz sam naslov, pa se gubi udesno. -->
    <LinearGradientBrush x:Key="NaslovLinijaBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E0A155" Offset="0" />
        <GradientStop Color="#6B4C2A" Offset="0.3" />
        <GradientStop Color="#2A2A2A" Offset="1" />
    </LinearGradientBrush>

    <!-- Izabran red: topla senka narandžaste, da izbor ima istu boju kao i traka uz njega. -->
    <LinearGradientBrush x:Key="IzabranRedBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2E2115" Offset="0" />
        <GradientStop Color="#191308" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================ ISHODI ============================
         Jedino mesto gde boja ostaje. Ishod testa je bezbednosni signal, a ne ukras:
         sivi PROŠAO i sivi PAO operater sa dva koraka razdaljine ne razlikuje dovoljno
         brzo. Uz boju i ovde ide krupan tekst, zbog daltonizma. -->
    <SolidColorBrush x:Key="PassBrush" Color="#3FDD7B" />
    <SolidColorBrush x:Key="PassBackBrush" Color="#10301D" />
    <SolidColorBrush x:Key="PassBorderBrush" Color="#1E7A43" />
    <SolidColorBrush x:Key="FailBrush" Color="#FF5069" />
    <SolidColorBrush x:Key="FailBackBrush" Color="#331015" />
    <SolidColorBrush x:Key="FailBorderBrush" Color="#8E2433" />
    <SolidColorBrush x:Key="WaitingBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="WaitingBackBrush" Color="#191919" />

    <!-- ============================ PORUKE ============================ -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B7D" />
    <SolidColorBrush x:Key="ErrorBackBrush" Color="#2B1216" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E8C275" />
    <SolidColorBrush x:Key="WarningBackBrush" Color="#282216" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#4A3F26" />
    <SolidColorBrush x:Key="DemoBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="DemoBorderBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="DemoTextBrush" Color="#E0E0E0" />

    <!-- ============================ MAPA PINOVA ============================
         Prikazuju se samo portovi koje kabl koristi, pa boje za neiskorišćene nema. -->
    <LinearGradientBrush x:Key="PinKoriscenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E8AC63" Offset="0" />
        <GradientStop Color="#CC8B45" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PinKoriscenIvicaBrush" Color="#EDB878" />
    <SolidColorBrush x:Key="PinKoriscenTekstBrush" Color="#150F07" />

</ResourceDictionary>
