<Window x:Class="CableTest.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:CableTest.App.Views"
        Title="CableTest — ispitivanje kablovskih setova"
        Icon="pack://application:,,,/app.ico"
        Height="860" Width="1440"
        MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource PozadinaBrush}"
        TextElement.Foreground="{DynamicResource TekstBrush}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI"
        FontSize="15">

    <!--
        Zaglavlje je ujedno i naslovna traka prozora: znak firme, stanje veze sa testerom i
        operater stoje tamo gde bi inače stajao Windows-ov naslov. Prozor se prevlači za
        zaglavlje, a dugmad za umanji/uvećaj/zatvori su naša, u istoj temi kao i ostatak ekrana.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="76"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================================================================================
             ZAGLAVLJE
             ================================================================================ -->
        <Border Grid.Row="0"
                Background="{DynamicResource ZaglavljeBrush}"
                BorderBrush="{DynamicResource ZaglavljeIvicaBrush}"
                BorderThickness="0,0,0,1"
                ClipToBounds="True">
            <Grid>

                <!-- Kose pruge — isti motiv kao na znaku firme; boja im zavisi od teme. -->
                <Rectangle HorizontalAlignment="Right" Width="460" Margin="0,-40,220,-40"
                           Opacity="0.05" Fill="{DynamicResource ZaglavljePrugeBrush}">
                    <Rectangle.RenderTransform>
                        <SkewTransform AngleX="-16" />
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!--
                    Krupna munja u pozadini zaglavlja — jedva vidljiva, taman toliko da se sa
                    vrata vidi da je ovo elektroradionica, a ne kancelarijski program.
                -->
                <Path Data="{StaticResource IkonaMunjaPuna}"
                      Fill="{DynamicResource AkcenatBrush}"
                      Opacity="0.10"
                      Stretch="Uniform" Height="150"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="440,0,0,0"
                      IsHitTestVisible="False" />

                <!-- Tanka narandžasta nit uz donju ivicu zaglavlja — kao pod naponom. -->
                <Border VerticalAlignment="Bottom" Height="2" HorizontalAlignment="Stretch"
                        Background="{DynamicResource ZaglavljeNitBrush}" />

                <DockPanel Margin="24,0,10,0">

                    <!-- Dugmad prozora -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Top" Margin="14,8,0,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="OnMinimize"
                                ToolTip="Umanji">
                            <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaUmanji}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="16" Height="16" />
                        </Button>
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="OnMaximize"
                                ToolTip="Uvećaj / vrati">
                            <Path Width="14" Height="14">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource IkonaStyle}">
                                        <Setter Property="Data" Value="{StaticResource IkonaUvecaj}" />
                                        <Setter Property="Stroke"
                                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="Maximized">
                                                <Setter Property="Data" Value="{StaticResource IkonaVrati}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <Button Style="{StaticResource ZatvoriButtonStyle}" Click="OnClose"
                                ToolTip="Zatvori">
                            <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaZatvori}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="16" Height="16" />
                        </Button>
                    </StackPanel>

                    <!-- Operater -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="22,0,0,0">
                        <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaOperater}"
                              Width="17" Height="17" Margin="0,0,9,0"
                              Stroke="{DynamicResource ZaglavljeTekst2Brush}" />
                        <TextBlock FontSize="14" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ZaglavljeTekst2Brush}">
                            <Run Text="Operater:" />
                            <Run Text="{Binding Testing.OperatorDisplayName, Mode=OneWay}"
                                 Foreground="{DynamicResource ZaglavljeTekstBrush}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>

                    <!--
                        Stanje veze sa testerom.

                        Pločica je zaobljen pravougaonik, u istom ključu kao kvadratić sa munjom
                        uz naziv programa — kapsula je pre toga delovala kao nalepnica prilepljena
                        na zaglavlje.

                        Znak stanja je munja, ista kao u ikoni aplikacije: puna narandžasta kad
                        veza radi, prazan obris kad ne radi. Uz oba stoji i tekst, pa se ne
                        oslanja samo na boju i oblik.
                    -->
                    <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                            Background="{DynamicResource ZaglavljePoljeBrush}"
                            BorderBrush="{DynamicResource ZaglavljeIvicaBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IkonaMunjaPuna}"
                                  Stretch="Uniform" Width="12" Height="17"
                                  VerticalAlignment="Center" Margin="0,0,10,0">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="Transparent" />
                                        <Setter Property="Stroke" Value="{DynamicResource SivaZnakaBrush}" />
                                        <Setter Property="StrokeThickness" Value="1.6" />
                                        <Setter Property="StrokeLineJoin" Value="Round" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Testing.ConnectionOk}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource AkcenatBrush}" />
                                                <Setter Property="Stroke" Value="{DynamicResource AkcenatBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{Binding Testing.ConnectionText}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ZaglavljeTekstBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Znak firme -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!--
                            Znak se prikazuje na dva načina, a tema bira koji:

                            • svetla tema — sama slika, sa svim sivim tonovima, jer je belo
                              zaglavlje podloga za koju je znak i crtan;
                            • tamna tema — znak je crn crtež i na crnom se ne bi video, pa ide
                              kao bela površina kojoj sam znak služi kao maska providnosti:
                              ista silueta, samo bela.

                            Koristi se „logo-znak.png" — sam znak, bez natpisa „BORBENI SLOŽENI
                            SISTEMI" ispod njega. Visina ostaje 46, ista kao kad je natpis bio
                            unutra, pa sam znak sada zauzima ceo taj prostor i krupniji je.

                            Širina 145 je tačan odnos slike (669×212) na visini 46, pa maska ne
                            ostavlja prazan hod sa strane.
                        -->
                        <Image Source="pack://application:,,,/logo-znak.png"
                               Width="145" Height="46" Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               Visibility="{DynamicResource ZnakSlikaVidljivost}" />

                        <Rectangle Width="145" Height="46" Fill="{DynamicResource ZnakBrush}"
                                   SnapsToDevicePixels="True"
                                   Visibility="{DynamicResource ZnakSiluetaVidljivost}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="pack://application:,,,/logo-znak.png" Stretch="Uniform" />
                            </Rectangle.OpacityMask>
                        </Rectangle>

                        <Rectangle Width="1" Height="34" Fill="{DynamicResource ZaglavljeIvicaBrush}" Margin="18,0" />

                        <!-- Munja uz naziv programa — znak elektroradionice. -->
                        <Border Width="34" Height="34" CornerRadius="9"
                                Background="{DynamicResource AkcenatPovrsinaBrush}"
                                VerticalAlignment="Center" Margin="0,0,13,0">
                            <Path Data="{StaticResource IkonaMunjaPuna}"
                                  Fill="{DynamicResource CrnaBrush}"
                                  Stretch="Uniform" Width="17" Height="17"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="Cable" FontSize="25" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ZaglavljeTekstBrush}" />
                        <TextBlock Text="Test" FontSize="25" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ZaglavljeTekstBrush}" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ================================================================================
             TELO: bočni meni i radna površina
             ================================================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================== BOČNI MENI ============================== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource MeniBrush}"
                    BorderBrush="{DynamicResource IvicaBrush}"
                    BorderThickness="0,0,1,0"
                    ClipToBounds="True">
                <DockPanel>
                    <ListBox x:Name="Meni"
                             SelectedIndex="0"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="0,12,0,0"
                             HorizontalContentAlignment="Stretch"
                             ItemContainerStyle="{StaticResource MeniStavkaStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VerticalAlignment="Top">
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaIspitivanje}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      Margin="0,0,14,0" />
                                <TextBlock Text="Ispitivanje" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaVozilo}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      Margin="0,0,14,0" />
                                <TextBlock Text="Vozila" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaKabl}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      Margin="0,0,14,0" />
                                <TextBlock Text="Kablovi" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaProgram}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      Margin="0,0,14,0" />
                                <TextBlock Text="Test programi" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaIstorija}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      Margin="0,0,14,0" />
                                <TextBlock Text="Istorija" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaPodesavanja}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      Margin="0,0,14,0" />
                                <TextBlock Text="Podešavanja" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>

                        <!--
                            Razvojni alat; stoji poslednji i podrazumevano se ne vidi. Poslednji je
                            i zato što se stavke biraju po rednom broju: sakrivena stavka na kraju
                            ne pomera nijedan postojeći ekran.
                        -->
                        <ListBoxItem Visibility="{Binding ShowCableConnector, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaKabl}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      Margin="0,0,14,0" />
                                <TextBlock Text="CableConnector" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ============================== RADNA POVRŠINA ============================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- demo traka -->
                    <RowDefinition Height="Auto" />
                    <!-- greška ili upozorenje -->
                    <RowDefinition Height="*" />
                    <!-- izabrani ekran -->
                    <RowDefinition Height="Auto" />
                    <!-- traka stanja -->
                </Grid.RowDefinitions>

                <!-- ================= DEMO TRAKA ================= -->
                <Border Grid.Row="0"
                        Background="{DynamicResource DemoBrush}"
                        BorderBrush="{DynamicResource DemoBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="24,11"
                        Visibility="{Binding Testing.IsDemoMode, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Simuliraj PROŠAO"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Command="{Binding Testing.SimulatePassCommand}" />
                            <Button Content="Simuliraj PAO"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Command="{Binding Testing.SimulateFailCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Testing.DemoBannerText}"
                                   Foreground="{DynamicResource DemoTextBrush}"
                                   FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <!-- ================= GREŠKA ILI UPOZORENJE ================= -->
                <Border Grid.Row="1" Padding="24,11" BorderThickness="0,0,0,1"
                        Visibility="{Binding Testing.HasProblem, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource WarningBackBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Testing.ProblemIsError}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ErrorBackBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource FailBorderBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Testing.ProblemText}" TextWrapping="Wrap"
                               FontSize="14" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Testing.ProblemIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- ================= IZABRANI EKRAN ================= -->
                <TabControl Grid.Row="2"
                            Background="Transparent"
                            BorderThickness="0"
                            SelectedIndex="{Binding SelectedIndex, ElementName=Meni}">
                    <TabControl.Template>
                        <!-- Kartice bira bočni meni, pa traka sa naslovima kartica nije potrebna. -->
                        <ControlTemplate TargetType="TabControl">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </ControlTemplate>
                    </TabControl.Template>

                    <TabItem Header="Ispitivanje">
                        <views:TestingView DataContext="{Binding Testing}" />
                    </TabItem>
                    <TabItem Header="Vozila">
                        <views:VozilaView DataContext="{Binding Catalog}" />
                    </TabItem>
                    <TabItem Header="Kablovi">
                        <views:KabloviView DataContext="{Binding Catalog}" />
                    </TabItem>
                    <TabItem Header="Test programi">
                        <views:TestProgramiView />
                    </TabItem>
                    <TabItem Header="Istorija">
                        <views:IstorijaView DataContext="{Binding History}" />
                    </TabItem>
                    <TabItem Header="Podešavanja">
                        <views:PodesavanjaView />
                    </TabItem>
                    <TabItem Header="CableConnector">
                        <views:CableConnectorView DataContext="{Binding CableConnector}" />
                    </TabItem>
                </TabControl>

                <!-- ================= TRAKA STANJA ================= -->
                <Border Grid.Row="3"
                        Background="{DynamicResource MeniBrush}"
                        BorderBrush="{DynamicResource IvicaBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="24,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,26,0">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,9,0"
                                     StrokeThickness="1.6">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="Transparent" />
                                        <Setter Property="Stroke" Value="{DynamicResource Tekst3Brush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Testing.IsMonitoring}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource AkcenatBrush}" />
                                                <Setter Property="Stroke" Value="{DynamicResource AkcenatBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Testing.StatusText}" Style="{StaticResource StatusLabelStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,26,0">
                            <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaFascikla}"
                                  Width="16" Height="16" Stroke="{DynamicResource Tekst3Brush}"
                                  VerticalAlignment="Center" Margin="0,0,9,0" />
                            <TextBlock Text="{Binding Testing.WatchedFileText}"
                                       ToolTip="{Binding Testing.WatchedFileText}"
                                       Style="{StaticResource StatusValueStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,26,0">
                            <Path Style="{StaticResource IkonaStyle}" Data="{StaticResource IkonaOsvezi}"
                                  Width="16" Height="16" Stroke="{DynamicResource Tekst3Brush}"
                                  VerticalAlignment="Center" Margin="0,0,9,0" />
                            <TextBlock Style="{StaticResource StatusLabelStyle}">
                                <Run Text="Poslednja promena:" />
                                <Run Text="{Binding Testing.LastChangeText, Mode=OneWay}"
                                     Foreground="{DynamicResource TekstBrush}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Rectangle Width="1" Height="18" Fill="{DynamicResource IvicaJakaBrush}" Margin="0,0,22,0" />
                            <TextBlock Style="{StaticResource StatusLabelStyle}" Margin="0,0,22,0">
                                <Run Text="Testova danas:" />
                                <Run Text="{Binding History.TodayTotal, Mode=OneWay}"
                                     Foreground="{DynamicResource TekstBrush}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource StatusLabelStyle}" Margin="0,0,22,0">
                                <Run Text="Prošlo:" />
                                <Run Text="{Binding History.TodayPassed, Mode=OneWay}"
                                     Foreground="{DynamicResource PassBrush}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource StatusLabelStyle}">
                                <Run Text="Palo:" />
                                <Run Text="{Binding History.TodayFailed, Mode=OneWay}"
                                     Foreground="{DynamicResource FailBrush}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
