<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CableTest</AssemblyName>
    <RootNamespace>CableTest.App</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Ikona .exe-a i prečice: isti znak koji stoji uz naziv programa u zaglavlju. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF SDK iz podrazumevanih using-a izbacuje System.IO; vraćamo ga, jer se radi sa fajlovima. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CableTest.Core\CableTest.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Znak firme se ugrađuje u .exe: aplikacija se pokreće i kad se pored nje ne kopira ništa.
         „logo-znak.png" je sam znak, bez natpisa ispod — to stoji u zaglavlju; „logo.png" je pun
         znak sa natpisom i ostaje kao izvorni oblik. -->
    <Resource Include="..\logo.png" Link="logo.png" />
    <Resource Include="..\logo-znak.png" Link="logo-znak.png" />
    <!-- Ista ikona i kao resurs, da je prozor (a s njim i traka zadataka) uzme iz .exe-a. -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Šablon mora biti pored izvršnog fajla: templates\MASTER.c61 -->
    <Content Include="..\templates\MASTER.c61" Link="templates\MASTER.c61">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Windows UI Automation; koristi ih isključivo razvojna strana „CableConnector“. -->
    <PackageReference Include="FlaUI.Core" Version="5.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

</Project>
