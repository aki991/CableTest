<Application x:Class="CableTest.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Application.Resources>
        <ResourceDictionary>

            <!--
                ================================================================================
                TAMNA „RADIONIČKA" TEMA
                ================================================================================

                Ekran stoji ceo radni dan iznad ispitnog stola, često pored jakog svetla, i
                operater ga gleda sa dva-tri koraka. Otuda tamna podloga, krupan tekst i jedno
                jedino mesto koje sme da bude svetlo i šareno: veliki prikaz ishoda. Sve ostalo
                je namerno prigušeno, da PROŠAO/PAO nikad nema takmaca u vidnom polju.

                Uz svaku boju ide i tekst — boja sama nije dovoljna (daltonizam).
            -->

            <!-- ============================ PODLOGE ============================ -->
            <SolidColorBrush x:Key="PozadinaBrush" Color="#0E0E0E" />
            <SolidColorBrush x:Key="MeniBrush" Color="#0A0A0A" />
            <SolidColorBrush x:Key="PanelBrush" Color="#161616" />
            <SolidColorBrush x:Key="Panel2Brush" Color="#1C1C1C" />
            <SolidColorBrush x:Key="Panel3Brush" Color="#242424" />

            <!-- Zaglavlje je belo, da znak firme stoji na podlozi za koju je i crtan. -->
            <LinearGradientBrush x:Key="ZaglavljeBrush" StartPoint="0,0" EndPoint="1,0.4">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#FAFAFA" Offset="0.6" />
                <GradientStop Color="#F0F0F0" Offset="1" />
            </LinearGradientBrush>

            <!-- ============================ IVICE ============================ -->
            <SolidColorBrush x:Key="IvicaBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="IvicaJakaBrush" Color="#3A3A3A" />

            <!-- ============================ TEKST ============================ -->
            <SolidColorBrush x:Key="TekstBrush" Color="#EDEDED" />
            <SolidColorBrush x:Key="Tekst2Brush" Color="#A0A0A0" />
            <SolidColorBrush x:Key="Tekst3Brush" Color="#6E6E6E" />
            <SolidColorBrush x:Key="BelaBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CrnaBrush" Color="#111111" />

            <!-- ======================= TEKST NA BELOM ZAGLAVLJU ======================= -->
            <SolidColorBrush x:Key="ZaglavljeTekstBrush" Color="#111111" />
            <SolidColorBrush x:Key="ZaglavljeTekst2Brush" Color="#5A5A5A" />
            <SolidColorBrush x:Key="ZaglavljeIvicaBrush" Color="#D2D2D2" />
            <SolidColorBrush x:Key="ZaglavljePoljeBrush" Color="#F4F4F4" />

            <!-- ============================ NAGLASAK ============================
                 Znak firme nema boju osim bele, crne i sive, pa je i naglasak bela:
                 izabrana stavka menija, izabran red i polje u fokusu. -->
            <SolidColorBrush x:Key="AkcenatBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AkcenatJakBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AkcenatPrigusenBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="SivaZnakaBrush" Color="#9A9A9A" />

            <!-- ============================ ISHODI ============================
                 Jedino mesto gde boja ostaje. Ishod testa je bezbednosni signal, a ne ukras:
                 sivi PROŠAO i sivi PAO operater sa dva koraka razdaljine ne razlikuje dovoljno
                 brzo. Uz boju i ovde ide krupan tekst, zbog daltonizma. -->
            <SolidColorBrush x:Key="PassBrush" Color="#3FDD7B" />
            <SolidColorBrush x:Key="PassBackBrush" Color="#10301D" />
            <SolidColorBrush x:Key="PassBorderBrush" Color="#1E7A43" />
            <SolidColorBrush x:Key="FailBrush" Color="#FF5069" />
            <SolidColorBrush x:Key="FailBackBrush" Color="#331015" />
            <SolidColorBrush x:Key="FailBorderBrush" Color="#8E2433" />
            <SolidColorBrush x:Key="WaitingBrush" Color="#A0A0A0" />
            <SolidColorBrush x:Key="WaitingBackBrush" Color="#191919" />

            <!-- ============================ PORUKE ============================ -->
            <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B7D" />
            <SolidColorBrush x:Key="ErrorBackBrush" Color="#2B1216" />
            <SolidColorBrush x:Key="WarningBrush" Color="#E8C275" />
            <SolidColorBrush x:Key="WarningBackBrush" Color="#282216" />
            <SolidColorBrush x:Key="WarningBorderBrush" Color="#4A3F26" />
            <SolidColorBrush x:Key="DemoBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="DemoBorderBrush" Color="#4A4A4A" />
            <SolidColorBrush x:Key="DemoTextBrush" Color="#E0E0E0" />

            <!-- ============================ MAPA PINOVA ============================
                 Iskorišćen port je svetao na tamnom, neiskorišćen taman na tamnom — isti odnos
                 kao beli i crni deo znaka. -->
            <SolidColorBrush x:Key="PinBrush" Color="#5A5A5A" />
            <LinearGradientBrush x:Key="PinKoriscenBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#EDEDED" Offset="0" />
                <GradientStop Color="#C9C9C9" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="PinKoriscenIvicaBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PinKoriscenTekstBrush" Color="#111111" />

            <LinearGradientBrush x:Key="IzabranRedBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#333333" Offset="0" />
                <GradientStop Color="#1A1A1A" Offset="1" />
            </LinearGradientBrush>

            <!-- ================================================================================
                 IKONE
                 Ugrađene kao geometrije: aplikacija radi na računaru pored ispitnog stola, koji ne
                 mora imati pristup internetu ni instaliran skup ikona.
                 ================================================================================ -->

            <Geometry x:Key="IkonaIspitivanje">M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12l1-8.5Z</Geometry>
            <Geometry x:Key="IkonaVozilo">M3 13.5 4.8 8a2 2 0 0 1 1.9-1.4h10.6A2 2 0 0 1 19.2 8L21 13.5 M3 13.5h18V18a1 1 0 0 1-1 1h-1.5a1 1 0 0 1-1-1v-1h-11v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-4.5Z</Geometry>
            <Geometry x:Key="IkonaKabl">M5.5 3v4.5M9.5 3v4.5 M4 7.5h7v2.8a3.5 3.5 0 0 1-3.5 3.5A3.5 3.5 0 0 1 4 10.3V7.5Z M7.5 13.8V16a4 4 0 0 0 4 4h2.5 M18.5 15.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Z</Geometry>
            <Geometry x:Key="IkonaProgram">M6 2.5h8L19 7.5V21a.5.5 0 0 1-.5.5h-12A.5.5 0 0 1 6 21V3a.5.5 0 0 1 .5-.5Z M13.5 2.5V8H19 M9 12.5h6M9 16h6</Geometry>
            <Geometry x:Key="IkonaIstorija">M3.5 12a8.5 8.5 0 1 0 2.6-6.1 M3.5 4.5V10H9 M12 7.5V12l3 2</Geometry>
            <Geometry x:Key="IkonaPodesavanja">M12 8.9a3.1 3.1 0 1 0 0 6.2 3.1 3.1 0 0 0 0-6.2Z M19.4 14.5a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-2.7 1.1v.3a2 2 0 1 1-4 0v-.2a1.6 1.6 0 0 0-2.8-1.1l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0-1.1-2.7H3.2a2 2 0 1 1 0-4h.2a1.6 1.6 0 0 0 1.1-2.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 2.7-1.1V3.2a2 2 0 1 1 4 0v.2a1.6 1.6 0 0 0 2.8 1.1l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0 1.1 2.7h.3a2 2 0 1 1 0 4h-.2a1.6 1.6 0 0 0-1.4.9Z</Geometry>
            <Geometry x:Key="IkonaOperater">M12 4.4a3.6 3.6 0 1 0 0 7.2 3.6 3.6 0 0 0 0-7.2Z M4.5 20.5a7.5 7.5 0 0 1 15 0</Geometry>
            <Geometry x:Key="IkonaLupa">M10.5 4a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13Z M15.5 15.5 21 21</Geometry>
            <Geometry x:Key="IkonaBarkod">M3.5 5v14M6.5 5v14M10 5v14M13.5 5v14M17 5v14M20.5 5v14</Geometry>
            <Geometry x:Key="IkonaStrelica">M9 5.5 15.5 12 9 18.5</Geometry>
            <Geometry x:Key="IkonaPotvrda">M4.5 12.5 9.5 17.5 19.5 6.5</Geometry>
            <Geometry x:Key="IkonaKrugPotvrda">M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z M8 12.3l2.8 2.8L16 9.5</Geometry>
            <Geometry x:Key="IkonaUzvicnik">M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z M12 7.5v5.5M12 16.4v.2</Geometry>
            <Geometry x:Key="IkonaSat">M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z M12 7v5.2l3.3 2</Geometry>
            <Geometry x:Key="IkonaPokreni">M7 4.5 19 12 7 19.5V4.5Z</Geometry>
            <Geometry x:Key="IkonaOsvezi">M20.5 12a8.5 8.5 0 1 1-2.6-6.1 M20.5 4.5V10H15</Geometry>
            <Geometry x:Key="IkonaFascikla">M3.5 6.5a1 1 0 0 1 1-1h4.2l1.8 2h9a1 1 0 0 1 1 1v9.5a1 1 0 0 1-1 1h-15a1 1 0 0 1-1-1v-11.5Z</Geometry>
            <Geometry x:Key="IkonaOznaka">M3.5 11.2V4.5a1 1 0 0 1 1-1h6.7a1 1 0 0 1 .7.3l8 8a1 1 0 0 1 0 1.4l-6.7 6.7a1 1 0 0 1-1.4 0l-8-8a1 1 0 0 1-.3-.7Z M7.8 6.5a1.3 1.3 0 1 0 0 2.6 1.3 1.3 0 0 0 0-2.6Z</Geometry>

            <Geometry x:Key="IkonaUmanji">M4 11.5h16</Geometry>
            <Geometry x:Key="IkonaUvecaj">M5 5h14v14H5z</Geometry>
            <Geometry x:Key="IkonaVrati">M8 8V5h11v11h-3 M5 8h11v11H5z</Geometry>
            <Geometry x:Key="IkonaZatvori">M6 6l12 12M18 6L6 18</Geometry>

            <!-- Osnovna ikona: tanka linija, zaobljeni krajevi, boja se nasleđuje od roditelja. -->
            <Style x:Key="IkonaStyle" TargetType="Path">
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="StrokeThickness" Value="1.8" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="Stroke" Value="{StaticResource Tekst2Brush}" />
            </Style>

            <!-- ================================================================================
                 TEKST
                 ================================================================================ -->

            <Style x:Key="NaslovKarticeStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="23" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource BelaBrush}" />
            </Style>

            <Style x:Key="NaslovStraneStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource BelaBrush}" />
                <Setter Property="Margin" Value="0,0,0,5" />
            </Style>

            <Style x:Key="OpisStraneStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource Tekst2Brush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="OdeljakNaslovStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TekstBrush}" />
            </Style>

            <Style x:Key="LabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource Tekst2Brush}" />
                <Setter Property="Margin" Value="0,0,0,7" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource Tekst2Brush}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="PodatakNazivStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14.5" />
                <Setter Property="Foreground" Value="{StaticResource Tekst2Brush}" />
                <Setter Property="Margin" Value="0,0,16,9" />
            </Style>

            <Style x:Key="PodatakVrednostStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TekstBrush}" />
                <Setter Property="Margin" Value="0,0,0,9" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="StatusLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Foreground" Value="{StaticResource Tekst2Brush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="StatusValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TekstBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="ZaglavljeTabeleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource Tekst2Brush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CelijaStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource TekstBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="CelijaJednoprostornaStyle" TargetType="TextBlock" BasedOn="{StaticResource CelijaStyle}">
                <Setter Property="FontFamily" Value="Consolas" />
            </Style>

            <!-- ================================================================================
                 KLIZAČ
                 Podrazumevani WPF klizač je svetao i na tamnoj podlozi upada u oči više nego
                 sadržaj koji pomera.
                 ================================================================================ -->

            <Style x:Key="KlizacPalacStyle" TargetType="Thumb">
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="#3D3D3D" CornerRadius="4" Margin="3" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.75" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Width" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource KlizacPalacStyle}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="Height" Value="11" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track" IsDirectionReversed="False">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" IsTabStop="False" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource KlizacPalacStyle}" />
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" IsTabStop="False" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ================================================================================
                 OBLAČIĆ
                 ================================================================================ -->

            <Style TargetType="ToolTip">
                <Setter Property="Foreground" Value="{StaticResource TekstBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{StaticResource Panel3Brush}"
                                    BorderBrush="{StaticResource IvicaJakaBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,7"
                                    MaxWidth="460">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================================================================================
                 DUGMAD
                 ================================================================================ -->

            <Style x:Key="DugmeStyle" TargetType="Button">
                <Setter Property="FontSize" Value="14.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TekstBrush}" />
                <Setter Property="Background" Value="{StaticResource Panel3Brush}" />
                <Setter Property="BorderBrush" Value="{StaticResource IvicaJakaBrush}" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Okvir"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Okvir" Property="BorderBrush" Value="{StaticResource AkcenatBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource BelaBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Okvir" Property="Background" Value="{StaticResource Panel2Brush}" />
                                    <Setter TargetName="Okvir" Property="BorderBrush" Value="{StaticResource IvicaBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource Tekst3Brush}" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource DugmeStyle}">
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Padding" Value="13,7" />
                <Setter Property="Margin" Value="8,0,0,0" />
            </Style>

            <Style x:Key="BigButtonStyle" TargetType="Button" BasedOn="{StaticResource DugmeStyle}">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Padding" Value="20,16" />
                <Setter Property="MinHeight" Value="58" />
            </Style>

            <!-- Jedno dugme po ekranu sme da bude belo: ono koje operater zaista pritiska. -->
            <Style x:Key="GlavnoDugmeStyle" TargetType="Button" BasedOn="{StaticResource BigButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource CrnaBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BelaBrush}" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFF" Offset="0" />
                            <GradientStop Color="#DCDCDC" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- Prelet i onemogućeno stanje moraju da nadjačaju pravila iz DugmeStyle,
                         koja tekst prebacuju na svetlo — na belom dugmetu on mora ostati crn. -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource CrnaBrush}" />
                        <Setter Property="Background" Value="{StaticResource BelaBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource Tekst3Brush}" />
                        <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource IvicaBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Dugmad prozora u zaglavlju (umanji, uvećaj, zatvori). Zaglavlje je belo, pa su
                 i ona tamna. -->
            <Style x:Key="CaptionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Foreground" Value="{StaticResource ZaglavljeTekst2Brush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Okvir" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Okvir" Property="Background" Value="#14000000" />
                                    <Setter Property="Foreground" Value="{StaticResource ZaglavljeTekstBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ZatvoriButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource ZaglavljeTekstBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ================================================================================
                 POLJE ZA UNOS
                 ================================================================================ -->

            <Style TargetType="TextBox">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{StaticResource TekstBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource TekstBrush}" />
                <Setter Property="SelectionBrush" Value="{StaticResource AkcenatBrush}" />
                <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
                <Setter Property="BorderBrush" Value="{StaticResource IvicaJakaBrush}" />
                <Setter Property="Padding" Value="11,9" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Okvir"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <!-- Uputstvo u praznom polju: Tag nosi tekst. -->
                                    <TextBlock x:Name="Uputstvo"
                                               Text="{TemplateBinding Tag}"
                                               Foreground="{StaticResource Tekst3Brush}"
                                               FontSize="{TemplateBinding FontSize}"
                                               Margin="{TemplateBinding Padding}"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"
                                               IsHitTestVisible="False" />
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="Uputstvo" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Okvir" Property="BorderBrush" Value="{StaticResource AkcenatBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================================================================================
                 POLJE ZA POTVRDU
                 Podrazumevani WPF CheckBox je svetla kutijica iz sistemske teme; na crnoj podlozi
                 izgleda kao da je sa drugog ekrana.
                 ================================================================================ -->

            <Style TargetType="CheckBox">
                <Setter Property="FontSize" Value="14.5" />
                <Setter Property="Foreground" Value="{StaticResource TekstBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Kutija" Width="19" Height="19" CornerRadius="5"
                                        Background="{StaticResource Panel2Brush}"
                                        BorderBrush="{StaticResource IvicaJakaBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Path x:Name="Kvacica"
                                          Data="{StaticResource IkonaPotvrda}"
                                          Stretch="Uniform" Width="11" Height="11"
                                          Stroke="{StaticResource CrnaBrush}" StrokeThickness="2.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Kutija" Property="Background" Value="{StaticResource BelaBrush}" />
                                    <Setter TargetName="Kutija" Property="BorderBrush" Value="{StaticResource BelaBrush}" />
                                    <Setter TargetName="Kvacica" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Kutija" Property="BorderBrush" Value="{StaticResource AkcenatBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource Tekst3Brush}" />
                                    <Setter TargetName="Kutija" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================================================================================
                 STABLO
                 Koristi ga samo razvojna strana „CableConnector“; podrazumevani WPF TreeView je
                 beo i sa plavim izborom, pa se ovde pravi u istoj temi kao i ostali spiskovi.
                 ================================================================================ -->

            <Style x:Key="DrvoStrelicaStyle" TargetType="ToggleButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent">
                                <!-- Sklopljeno: strelica udesno. Rasklopljeno: strelica nadole. -->
                                <Path x:Name="Strelica"
                                      Data="M5.5 3.5 10.5 8 5.5 12.5"
                                      Stroke="{StaticResource Tekst2Brush}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Strelica" Property="Data" Value="M3.5 5.5 8 10.5 12.5 5.5" />
                                    <Setter TargetName="Strelica" Property="Stroke" Value="{StaticResource BelaBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Strelica" Property="Stroke" Value="{StaticResource BelaBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DrvoStavkaStyle" TargetType="TreeViewItem">
                <Setter Property="Foreground" Value="{StaticResource TekstBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <!-- Izbor ide u oba smera: i klik operatera i čvor koji strana sama označi (F8). -->
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TreeViewItem">
                            <StackPanel>
                                <Border x:Name="Okvir" Background="Transparent" CornerRadius="6"
                                        Padding="6,5" Margin="0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton x:Name="Strelica" Grid.Column="0"
                                                      Style="{StaticResource DrvoStrelicaStyle}"
                                                      ClickMode="Press"
                                                      VerticalAlignment="Top" Margin="0,1,0,0"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                          ContentSource="Header"
                                                          HorizontalAlignment="Stretch" />
                                    </Grid>
                                </Border>
                                <ItemsPresenter x:Name="Deca" Margin="17,0,0,0" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="False">
                                    <Setter TargetName="Deca" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="Strelica" Property="Visibility" Value="Hidden" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Okvir" Property="Background" Value="{StaticResource IzabranRedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DrvoStyle" TargetType="TreeView">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource DrvoStavkaStyle}" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>

            <!-- ================================================================================
                 PADAJUĆA LISTA
                 ================================================================================ -->

            <Style x:Key="ComboToggleStyle" TargetType="ToggleButton">
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="ClickMode" Value="Press" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource TekstBrush}" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Okvir" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Okvir" Property="Background" Value="#24FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{StaticResource TekstBrush}" />
                <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
                <Setter Property="BorderBrush" Value="{StaticResource IvicaJakaBrush}" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="Okvir"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ContentPresenter Grid.Column="0"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"
                                                          IsHitTestVisible="False" />

                                        <Path Grid.Column="1"
                                              Data="M1,1 L5,5 L9,1"
                                              Stroke="{StaticResource Tekst2Brush}"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="10" Height="6"
                                              Stretch="Uniform"
                                              Margin="0,0,14,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False" />
                                    </Grid>
                                </Border>

                                <ToggleButton Style="{StaticResource ComboToggleStyle}"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                                <Popup x:Name="PART_Popup"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       Placement="Bottom"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade"
                                       Focusable="False">
                                    <Border Background="{StaticResource Panel3Brush}"
                                            BorderBrush="{StaticResource IvicaJakaBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,4,0,0"
                                            MinWidth="{TemplateBinding ActualWidth}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Okvir" Property="BorderBrush" Value="{StaticResource AkcenatBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource Tekst3Brush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================================================================================
                 SPISAK KABLOVA
                 ================================================================================ -->

            <Style x:Key="SpisakStyle" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="RedKablaStyle" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource Tekst2Brush}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Okvir"
                                    Background="Transparent"
                                    BorderBrush="#26FFFFFF"
                                    BorderThickness="0,0,0,1"
                                    Padding="11,12">
                                <Grid>
                                    <Rectangle x:Name="Traka" Width="3" Fill="Transparent"
                                               HorizontalAlignment="Left" Margin="-11,-12,0,-12" />
                                    <ContentPresenter />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Okvir" Property="Background" Value="#14FFFFFF" />
                                    <Setter Property="Foreground" Value="{StaticResource TekstBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Okvir" Property="Background" Value="{StaticResource IzabranRedBrush}" />
                                    <Setter TargetName="Traka" Property="Fill" Value="{StaticResource AkcenatBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource BelaBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================================================================================
                 BOČNI MENI
                 ================================================================================ -->

            <Style x:Key="MeniStavkaStyle" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource Tekst2Brush}" />
                <Setter Property="FontSize" Value="15.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Okvir" Background="Transparent" Padding="15,14">
                                <Grid>
                                    <Rectangle x:Name="Traka" Width="3" Fill="Transparent"
                                               HorizontalAlignment="Left" Margin="-15,-14,0,-14" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Okvir" Property="Background" Value="#14FFFFFF" />
                                    <Setter Property="Foreground" Value="{StaticResource TekstBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Okvir" Property="Background" Value="{StaticResource IzabranRedBrush}" />
                                    <Setter TargetName="Traka" Property="Fill" Value="{StaticResource AkcenatBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource BelaBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================================================================================
                 PRETVARAČI
                 ================================================================================ -->

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
