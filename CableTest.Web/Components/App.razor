@* Korenska stranica aplikacije — ono što je u desktop verziji MainWindow. *@
<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>CableTest — ispitivanje kablovskih setova</title>
    <link rel="icon" href="data:," />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script>
        // Skener barkoda se ponasa kao tastatura: pise u polje koje je u fokusu.
        window.cableTestFocus = function (id) {
            const polje = document.getElementById(id);
            if (polje) { polje.focus(); polje.select(); }
        };
    </script>
</body>
</html>
